091C:                   BYTERDR:
                        		
091C: 1600     [ 7]     	LD	D,000h		;Set up   ;	* Get 2 ASCII chrs as hex byte	*
091E: CD2609   [24]     	CALL	HEXCONR		;Get byte and convert to hex
0921: 87       [28]     	ADD	A,A		;First nibble so
0922: 87       [32]     	ADD	A,A		;multiply by 16
0923: 87       [36]     	ADD	A,A		;
0924: 87       [40]     	ADD	A,A		;
0925: 57       [44]     	LD	D,A		;Save hi nibble in D
0926:                   HEXCONR:
                        	
0926: 23       [ 6]     	INC HL                ;HL:FF21
                        	
0927: 7E       [13]     	LD A, (HL)
                        		
                        	;CALL	RXD		;Get next chr
0928: D630     [20]     	SUB	030h		;Makes '0'-'9' equal 0-9
092A: FE0A     [27]     	CP	00Ah		;Is it 0-9 ?
092C: 3802     [34|39]  	JR	C,NALPHAR	;If so miss next bit
092E: D607     [41]     	SUB	007h		;Else convert alpha
0930:                   NALPHAR:	
0930: B2       [ 4]     	OR	D		;Add hi nibble back
0931: C9       [14]     	RET			;RESULT STORED IN A REGISTER!
                        
                        
                        
