                        ;	*********************************
                        ;	*				*
                        ;	*     Get Intel hex record	*
                        ;	*				*
                        ;	*********************************
                        
                        ;Short version - no checksum calculation.
                        
0967:                   INTLIN1:	
0967: 3E00     [ 7]     	LD A,000H
0969: 324BFF   [20]     	LD (HEXLDREG),A
096C: CD4800   [17]     INTLIN:	CALL	RXD		;Get chr
096F: FE1B     [24]     	CP  1BH
0971: C8       [29|35]  	RET Z
0972: FE3A     [36]     	CP	':'		;Is it ':'?
0974: 20F6     [43|48]  	JR	NZ,INTLIN	;If not then next
0976: CDA209   [60]     	CALL	BYTERD		;Get record length
0979: 47       [64]     	LD	B,A		;Put in B
097A: CDA209   [81]     	CALL	BYTERD		;Get record address hi byte
097D: 67       [85]     	LD	H,A		;Put in H
097E: CDA209   [102]    	CALL	BYTERD		;Get record address lo byte
0981: 6F       [106]    	LD	L,A		;Put in L
                        	
0982: 3A4BFF   [119]    	LD A,(HEXLDREG)		;CHECK IF HL RECORDED TO DISPLAY SOURCE ADRESS BEFORE?
0985: FE01     [126]    	CP 01                   ;IF NOT, RECORD IT. OTHERWISE GO ON
0987: CA9209   [136|136]	JP Z,GO_ON
098A: 3E01     [143]    	LD A,001H
098C: 324BFF   [156]    	LD (HEXLDREG),A
098F: 2250FF   [172]    	LD (LOADSTADR),HL	; LOADED PROGRAM START ADRESS HEADER REGISTER
                        	
0992: CDA209   [17]     GO_ON:	CALL	BYTERD		;Record type(NOT IGNORED IN EFEX MON)
0995: FE01     [24]     	CP 01                   ;IF END OF FILE THEN EXIT PROGRAM
0997: C8       [29|35]  	RET Z          ;JP Z,LOAD_ED        PROGRAM ENDED RETURN TO HOME
                        	
                        	
0998: CDA209   [17]     DATAIN:	CALL	BYTERD		;Get record data byte
099B: 77       [24]     	LD	(HL),A		;Save byte to memory
099C: 23       [30]     	INC	HL		;Next address
099D: 10F9     [38|43]  	DJNZ	DATAIN		;Decrement count and jump if not finished
099F: 18CB     [50]     	JR	INTLIN		;Ignore checksum byte and [CR][LF]
                        	
09A1: C9       [60]     	RET		;PROGRAM ENDED RETURN HOME
                        
09A2: 1600     [ 7]     BYTERD:	LD	D,000h		;Set up   ;	* Get 2 ASCII chrs as hex byte	*
09A4: CDAC09   [24]     	CALL	HEXCON		;Get byte and convert to hex
09A7: 87       [28]     	ADD	A,A		;First nibble so
09A8: 87       [32]     	ADD	A,A		;multiply by 16
09A9: 87       [36]     	ADD	A,A		;
09AA: 87       [40]     	ADD	A,A		;
09AB: 57       [44]     	LD	D,A		;Save hi nibble in D
09AC: CD4800   [17]     HEXCON:	CALL	RXD		;Get next chr
09AF: D630     [24]     	SUB	030h		;Makes '0'-'9' equal 0-9
09B1: FE0A     [31]     	CP	00Ah		;Is it 0-9 ?
09B3: 3802     [38|43]  	JR	C,NALPHA	;If so miss next bit
09B5: D607     [45]     	SUB	007h		;Else convert alpha
09B7: B2       [ 4]     NALPHA:	OR	D		;Add hi nibble back
09B8: C9       [14]     	RET			;
                        
                        ;-------------------------Hex load finished-----------------
                        
                        ;--------------------------INTEL HEX SAVE ROUTINE
                        ;,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
                        ;INTEL HEX SAVE PROGRAM         ;
                        ;,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
                        ;	LD HL,START ADRESS
                        ;	LD DE, END ADRESS
                        	
09B9:                   INTSAVE:
09B9: E5       [11]     	PUSH HL
09BA: EB       [15]     	EX DE,HL
09BB: ED52     [30]     	SBC HL,DE
09BD: EB       [34]     	EX DE,HL
09BE: E1       [44]     	POP HL
09BF: 3E00     [51]     	LD A,0
09C1: 3234FF   [64]     	LD (SAVECHCK),A	;RESET CHECKSUM COUNTER
09C4: 0610     [71]     	LD B,10H
                        	
09C6: 3E0D     [78]     	LD A,0DH		;ENTER
09C8: CD3C00   [95]     	CALL TXD ;TXD ROUTINE
09CB: 3E0A     [102]    	LD A,0AH
09CD: CD3C00   [119]    	CALL TXD ;TXD ROUTINE
                        	
09D0: 7A       [ 4]     COMP:	LD A,D	; DE TEK BAYTA INMIS
09D1: FE00     [11]     	CP 0
09D3: CAD909   [21|21]  	JP Z, MINUS
09D6: C3E609   [31]     	JP DONGU
                        	
09D9: 7B       [ 4]     MINUS:	LD A,E      ;E 10H TAN KUCUKSE..
09DA: D610     [11]     	SUB 10H
09DC: DAE209   [21|21]  	JP C,MINIMUS
09DF: C3E609   [31]     	JP DONGU
                        	
09E2: 43       [ 4]     MINIMUS: LD B,E    ;DE 10H TAN AZ
09E3: C3E809   [14]     	JP DONGU1 
                        	
09E6: 0610     [ 7]     DONGU:	LD B,10H
09E8: 3E3A     [ 7]     DONGU1:	LD A,':'
09EA: CD3C00   [24]     	CALL TXD ;TXD ROUTINE		;SEND START CODE
09ED: 78       [28]     	LD A,B
09EE: CD370A   [45]     	CALL HEXOUT		;SEND BYTE COUNT (DEFAULT 16)
                        	
09F1: 7C       [49]     	LD A,H 			;SEND RECORD ADRESS
09F2: CD370A   [66]     	CALL HEXOUT
09F5: 7D       [70]     	LD A,L
09F6: CD370A   [87]     	CALL HEXOUT
                        	
09F9: 3E00     [94]     	LD A,0 			;SEND RECORD TYPE (0=DATA)
09FB: CD370A   [111]    	CALL HEXOUT
                        	
09FE: CD1F0A   [128]    	CALL YAZ
0A01: 7A       [132]    	LD A,D		;DE BYTE COUNT REACHED?
0A02: B3       [136]    	OR E
0A03: C2D009   [146|146]	JP NZ, COMP
                        	
0A06: 3E3A     [153]    	LD A,':'		;ENDING COLON
0A08: CD3C00   [170]    	CALL TXD ;TXD ROUTINE		
0A0B: 0607     [177]    	LD B,07H
0A0D: 3E30     [ 7]     DISEND:	LD A,'0'
0A0F: CD3C00   [24]     	CALL TXD ;TXD ROUTINE
0A12: 10F9     [32|37]  	DJNZ DISEND
0A14: 3E31     [39]     	LD A,'1'
0A16: CD3C00   [56]     	CALL TXD ;TXD ROUTINE
0A19: 3EFF     [63]     	LD A,0FFH
0A1B: CD370A   [80]     	CALL HEXOUT
                        	
0A1E: C9       [90]     	RET      ;PROGRAM ENDED    CALL RE_START	RESET DISPLAYS
                        	         ;JP MA_IN	;TURN INTO ROM
                        
                        	
                        	
                        	
                        	
0A1F: 7E       [ 7]     YAZ:	LD A,(HL)
0A20: CD370A   [24]     	CALL HEXOUT
0A23: 23       [30]     	INC HL
0A24: 1B       [36]     	DEC DE
0A25: 10F8     [44|49]  	DJNZ YAZ		;16 BYTES SENDED
0A27: 3EFF     [51]     	LD A, 0FFH		;SEND FAKE CHECKSUM
0A29: CD370A   [68]     	CALL HEXOUT
                        	
0A2C: 3E0D     [75]     	LD A,0DH		;ENTER
0A2E: CD3C00   [92]     	CALL TXD ;TXD ROUTINE
0A31: 3E0A     [99]     	LD A,0AH
0A33: CD3C00   [116]    	CALL TXD ;TXD ROUTINE
0A36: C9       [126]    	RET
                        		
