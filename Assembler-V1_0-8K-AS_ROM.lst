                        ;----------------INPUT HEX TO BYTE CONVERTER 2 BYTE OR 1 BYTE---------
0907:                   INTLINR:                   ;4 NIBBLE  INPUT   
0907: 211FFF   [10]     	LD HL, KEYINBUF -1 ; 
090A: 7E       [17]     	LD A,(HL)
090B: CD1C09   [34]     	CALL BYTERDR 
090E: 3241FF   [47]     	LD (KEYINRES + 1),A 
                        	
