                        ;-------------------------------------------------
                        ;Z80 DISASSEMBLER LISTING
                        ;Label  Instruction
                        ;-------------------------------------------------
                        
                        ;VERSION HISTORY 
                        
                        ; AFTER DDCB COMMANDS EXCLUDED
                        ;FILL ADDED, DISASSEMBLER NOTFOUNT RESULT IMPROVED
                        ;ASSEMBLER HAVE LIMITED BACKSPACE
                        ;HEX INPUT IMPROVED
                        
                        
                        
                        ;INTLIN1 TURNED INTO SUBROUTINE
                        ;S-AVE, L-OAD, E-DIT,R-UN,M-OVE COMMANDS ADDED
                        ;EFEX INLINE ASSEMBLER V.087 - 06.APR.2017
                        
                        ;SYSTEM VARIABLES:
                        ;3F60-3F6F  :COMMAND INPUT BUFFER			;COMINBUF
                        ;3FA0-3FA1  :COMMAND LINE LENGHT TO BE TRANSLATED	;LINELENGHT
                        ;3F80-3F90  :CODE BUFFER-----				;CODEBUF
                        ;3FA2-3FA3  :MNEMONIC TABLE FFINDED INDEX ADRESS	;TABFINDAD
                        ;3FA4-3FA5  :ASSEMBLY ADRESS				;ASADR
                        ;3FA6-3FA7  :ASSEMBLY ADRES + CODES TO WRITE MEMORY	;ASADCODE
                        ;3FB0	    :OPERAND BYTE COUNT				;OPBYTECNT
                        ;3FB2	    : # OR $ OR NULL				;DIYEZDOLAR
                        ;3F42       :# CONTENT (DATA)				;DATAINP
                        ;3F43-3F44  :$ CONTENT (ADRESS)				;ADRSINP
                        ;3FB3-3FB4  :CODE BUF. LENGHT				;CODEBUFLEN
                        ;
                        ;
                        ;ASSEMBLER VARIABLES FOR ROM:
FF60:                     	COMINBUF .EQU 0FF60H    ;10H CHAR LENGHT
FF80:                   	CODEBUF .EQU 0FF80H	;10H CHAR LENGHT
FFA0:                   	LINELENGHT .EQU 0FFA0H	;2 BYTE
FFA2:                   	TABFINDAD .EQU 0FFA2H	;2 BYTE
FFA4:                   	ASADR .EQU 0FFA4H		;2 BYTE
FFA6:                   	ASADCODE .EQU 0FFA6H	;2 BYTE
FFB0:                   	OPBYTECNT .EQU 0FFB0H	;1 BYTE
FFB2:                   	DIYEZDOLAR .EQU 0FFB2H	;1 BYTE
FF42:                   	DATAINP .EQU 0FF42H	;1 BYTE
FF43:                   	ADRSINP .EQU 0FF43H	;2 BYTE
FFB3:                   	CODEBUFLEN .EQU 0FFB3H	;2 BYTE
                        
FF20:                   	KEYINBUF .EQU 0FF20H	;4 BYTE
FF40:                   	KEYINRES .EQU 0FF40H	;4 BYTE
                        	
                        ;HEX RECORD VARIABLES FOR ROM
FF4B:                   	HEXLDREG .EQU 0FF4BH	;2 BYTE
FF50:                   	LOADSTADR .EQU 0FF50H	;2 BYTE
FF34:                   	SAVECHCK .EQU 0FF34H	;2 BYTE
FF32:                   	LOWNIBBLE .EQU 0FF32H	;1 BYTE
FF33:                   	HIGHNIBBLE .EQU 0FF33H	;1 BYTE
                        ;EDIT ADRESS
F906:                   	EDITADR .EQU 0F906H
                        ;INTERRUPT (IM1, 0038) ADRESS POINTER
F908:                   	INTADRS .EQU 0F908H  ;INT ADRESS POINTER
                        			     ;INTADRES +2: 090A : NMI POINTER
                        ;STACK POINTER;
F7FD:                   	STACKPOINT .EQU  0F7FDH	;2 BYTE ; UNCOMMENT THIS TO RUN IN ROM
                        
                        	
                        
                        ;-------------------------------------------------
                        ;4 mhz clock,1834 uart clock (DIVIDE BY 16),  8k rom, 8k ram
                        ;PORT 00:UART data, port 01 control/status
                        ;PORT 08:8255    08 input,  09 and 0A output
                        ;
0000:                   	.org 00000H    ;CHANGE 0000 RO RUN IN ROM!
                        	
0000: 31FDF7   [10]     	LD SP,STACKPOINT  ; STACK AT THE END OF  RAM
0003: 217200   [20]     	LD HL,MA_IN	  ;DEFAULT INTERUPT ROUTINE IS MA_IN PROGRAM
0006: 2208F9   [36]     	LD (INTADRS),HL
0009: ED56     [44]             IM 1
000B: FB       [48]     	EI
                        	;DI		;DEFAULT: INTERRUPTS DISABLED
                        	
                        	
                        ;	JP GREET       ; TURN TO COMMENT TO RUN IN ROM
                        
                        
                               
                        
                        
                        ;----------------INIT-8251----------------------------------
                        
                        
                        
                        
000C:                   INIT8255:
000C: 3E90     [ 7]     	LD A,90H
000E: D30B     [18]     	OUT (00BH),A
0010:                   INIT8251:	
                        
0010: 3E40     [ 7]             LD A,040H            
0012: D301     [18]             OUT (001H),A  
0014: 00       [22]             NOP
0015: 00       [26]     	NOP  
0016: 3E40     [33]             LD A,040H            
0018: D301     [44]             OUT (001H),A
001A: 00       [48]     	NOP
001B: 00       [52]     	NOP  
                                          
001C: 3E40     [59]             LD A,040H            
001E: D301     [70]             OUT (001H),A  ; WORST CASE INIT
0020: 00       [74]     	NOP
0021: 00       [78]     	NOP
                        	
                        	
                        	
0022: 3E40     [85]             LD A,040H            
0024: D301     [96]             OUT (001H),A  		; RESET 8251
0026: 00       [100]            NOP
0027: 00       [104]    	NOP
                        
0028: 3E4E     [111]            LD A,04EH            
002A: D301     [122]            OUT (001H),A      	 ; 8-N-1  CLK/1  4EH FOR /16, 4D FOR /1  (MODE )
002C: 00       [126]            NOP
002D: 00       [130]    	NOP    
002E: 3E37     [137]            LD A,037H            
0030: D301     [148]            OUT (001H),A      	 ; RESET ALL ERROR FLAGS AND ENABLE RXRDY,TXRDY (COMMAND)
                        
0032: C36A00   [158]            JP GREET
                        ;-----------------------------------------------------------------------------------
                        ;   UNCOMMENT THIS TO RUN IN ROM
                        
                        	.ORG 0038H               ;CHANGEABLE INTERRUPT SUBROUTINE
0038: 2A08F9   [174]    	LD HL,(INTADRS)
003B: E9       [178]    	JP (HL)
                        	
                        ;-------------------------------------------------------------------------------------
                        	
                        ;TXD ROUTINE sends contents of A REGISTER  to serial out pin 
                        ;19200 BAUD, 8-N-1
                        
                        
003C: F5       [11]     TXD:    PUSH AF
003D: DB01     [11]     LOPTX: 	IN A,(01H)
003F: E601     [18]     	AND 001H     ;TXRDY?
0041: CA3D00   [28|28]  	JP Z, LOPTX
0044: F1       [38]             POP AF
0045: D300     [49]     	OUT (00H),A
0047: C9       [59]             RET
                        	
                        ;----------------------------------------------------------------------------------
                        ;RXD ROUTINE receives 1 bayt from serial  to A REGISTER 
                        ;19200 BAUD, 8-N-1
                        
0048:                   RXD:    
0048: 3E37     [ 7]     	LD A,037H
004A: D301     [18]     	OUT (01),A ;ENABLE TX AND RX AND CLEAR ERR BITS
                        	
004C: DB01     [11]     LOPTR: 	IN A,(01H)
004E: E602     [18]     	AND 002H     ;TXRDY?
0050: CA4C00   [28|28]  	JP Z, LOPTR
0053: DB00     [39]             IN A,(00H)   ;RECEIVE CHAR
0055: C9       [49]     	RET
                        	
                        	
                        ;-----------------------------------------------------------------------------------
                        ;   UNCOMMENT THIS TO RUN IN ROM
                        
                        	.ORG 0066H               ;CHANGEABLE NMI INTERRUPT SUBROUTINE
0066: 2A0AF9   [65]     	LD HL,(INTADRS+2)
0069: E9       [69]     	JP (HL)
                        	
                        ;-------------------------------------------------------------------------------------	
                        	
                        	
                        	
                        		
                        ;----------------GREETING MESSAGE----------------------
                        
                        
006A:                   GREET:
                        			 ;GREETING  MSG
006A: 21890A   [10]     	LD HL,TABLE
006D: 0639     [17]     	LD B,57   ; DECIMAL IF NOT H AT THE END
006F: CDBA01   [34]     	CALL PRINT
                        	
                        
                        	
                        	
                        
                        
                        
