                        ;----------------INPUT HEX TO BYTE CONVERTER 2 BYTE OR 1 BYTE---------
0E29:                   INTLINR:                   ;4 NIBBLE  INPUT   
0E29: 212FFF   [10]     	LD HL, KEYINBUF -1 ; 
0E2C: 7E       [17]     	LD A,(HL)
0E2D: CD3E0E   [34]     	CALL BYTERDR 
0E30: 3235FF   [47]     	LD (KEYINRES + 1),A 
                        	
0E33:                   INLIN2:	
0E33: 2131FF   [10]         LD HL, KEYINBUF + 1       ;2 NIBBLE INPUT
0E36: 7E       [17]     	LD A,(HL)
0E37: CD3E0E   [34]     	CALL BYTERDR 
0E3A: 3234FF   [47]     	LD (KEYINRES),A 
0E3D: C9       [57]     	RET
                        	
                        
0E3E:                   BYTERDR:
                        		
0E3E: 1600     [ 7]     	LD	D,000h		;Set up   ;	* Get 2 ASCII chrs as hex byte	*
0E40: CD480E   [24]     	CALL	HEXCONR		;Get byte and convert to hex
0E43: 87       [28]     	ADD	A,A		;First nibble so
0E44: 87       [32]     	ADD	A,A		;multiply by 16
0E45: 87       [36]     	ADD	A,A		;
0E46: 87       [40]     	ADD	A,A		;
0E47: 57       [44]     	LD	D,A		;Save hi nibble in D
0E48:                   HEXCONR:
                        	
0E48: 23       [ 6]     	INC HL                ;HL:FF21
                        	
0E49: 7E       [13]     	LD A, (HL)
                        		
                        	;CALL	RXD		;Get next chr
0E4A: D630     [20]     	SUB	030h		;Makes '0'-'9' equal 0-9
0E4C: FE0A     [27]     	CP	00Ah		;Is it 0-9 ?
0E4E: DA530E   [37|37]  	JP	C,NALPHAR	;If so miss next bit
0E51: D607     [44]     	SUB	007h		;Else convert alpha
0E53:                   NALPHAR:	
0E53: B2       [ 4]     	OR	D		;Add hi nibble back
0E54: C9       [14]     	RET			;RESULT STORED IN A REGISTER!
                        ;------------------BYTE CONVERTER FINISHED HERE---------------
                        
                        
                        ;---------------LOAD HEX FILE ROUTINE --------------------------
