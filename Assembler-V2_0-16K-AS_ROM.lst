                        ;****************************************************************
                        ;* PARSE_HEX_CHAR ALT PROGRAMI                                  *
                        ;* Açıklama: HL'nin gösterdiği adresteki karakteri okur. Eğer   *
                        ;* karakter geçerli bir hex ise, 4-bitlik değerini A'ya yazar,  *
                        ;* HL'yi bir artırır ve Carry=0 ile döner. Geçersizse,          *
                        ;* Carry=1 ile döner.                                           *
                        ;* Girdi: HL = Buffer içindeki karakterin adresi                *
                        ;* Çıktı: Başarılıysa -> Carry=0, A=Sayısal değer (0-15), HL artırılmış*
                        ;* Başarısızsa -> Carry=1, A=Karakterin ASCII kodu, HL aynı*
                        ;****************************************************************
01C9:                   PARSE_HEX_CHAR:
01C9: 7E       [ 7]         LD A, (HL)          ; Buffer'dan karakteri oku
01CA: CD6E02   [24]         CALL UPPERCASE      ; Kontrol kolaylığı için büyük harfe çevir
                        
                            ; --- DOĞRULAMA KISMI ---
01CD: FE30     [31]         CP '0'
01CF: DAF001   [41|41]      JP C, NOT_A_HEX     ; '0'dan küçükse geçersiz
01D2: FE3A     [48]         CP '9' + 1
01D4: DAE401   [58|58]      JP C, CONVERT_DIGIT ; '9'dan büyük değilse, bu bir rakamdır
                        
01D7: FE41     [65]         CP 'A'
01D9: DAF001   [75|75]      JP C, NOT_A_HEX     ; 'A'dan küçükse geçersiz
01DC: FE47     [82]         CP 'F' + 1
01DE: D2F001   [92|92]      JP NC, NOT_A_HEX    ; 'F'den büyükse geçersiz
                            
                            ; Karakter 'A'-'F' aralığındadır
01E1: C3E901   [102]        JP CONVERT_LETTER
                        
01E4:                   CONVERT_DIGIT:
01E4: D630     [ 7]         SUB '0'             ; ASCII değerini sayısal değere çevir
01E6: C3ED01   [17]         JP CONVERSION_OK
                        
01E9:                   CONVERT_LETTER:
01E9: D641     [ 7]         SUB 'A'             ; 'A'->0, 'B'->1, ...
01EB: C60A     [14]         ADD A, 10           ; Doğru sayısal değeri bulmak için 10 ekle
                        
01ED:                   CONVERSION_OK:
01ED: 23       [ 6]         INC HL              ; Başarılı, buffer işaretçisini bir sonraki karaktere ilerlet
01EE: B7       [10]         OR A                ; Carry bayrağını temizle (başarı sinyali)
01EF: C9       [20]         RET
                        
01F0:                   NOT_A_HEX:
01F0: 37       [ 4]         SCF                 ; Carry bayrağını set et (hata sinyali)
01F1: C9       [14]         RET    
                        ;------------hex to byte from buffer ended------------------------------------
                        ;****************************************************************
                        ;* PARSE_HEX_ADDRESS ALT PROGRAMI                               *
                        ;* Açıklama: HL'nin gösterdiği yerden başlayarak 1-4 haneli hex *
                        ;* bir adresi okur. Sonucu DE register'ına yazar.               *
                        ;* Girdi: HL = Buffer'da adresin başladığı yer                   *
                        ;* Çıktı: Başarılıysa -> Carry=0, DE=16-bit adres, HL=sonraki karakter*
                        ;* Başarısızsa -> Carry=1 (hiç hex karakter bulunamadıysa)      *
                        ;****************************************************************
                        ; ------------------------------------------------------------
                        ; PARSE_HEX_ADDRESS  (Z80 mnemonics, 8085-compatible)
                        ;  In : HL -> girdi metni (hexdigit'lerle başlıyor olabilir)
                        ; Out : CF=0 ve DE = parsed 16-bit değer, HL = ilk hexdigit olmayan
                        ;       CF=1 (hata: hiç hexdigit yok) ve HL girişteki konumda
                        ; Clobbers: A, B, C, D, E, F   (HL çağrı sözleşmesine göre güncellenir)
                        ; Notlar:
                        ; - En fazla 4 hexdigit okunur (16-bit sınırı). 5. hexdigit bırakılır.
                        ; - '0'..'9', 'A'..'F', 'a'..'f' kabul edilir (buffer değiştirilmez).
                        ; ------------------------------------------------------------
                        ;******************************************************************************
                        ;* PARSE_HEX_ADDRESS (Nihai Sürüm - Basit, Kararlı, Z80 Sözdizimli)           *
                        ;* Açıklama: HL'nin gösterdiği yerden 1-4 haneli hex adresi okur.            *
                        ;* Sonucu sağa dayalı olarak hesaplar (Örn: "F" -> 000FH, "1F4" -> 01F4H).     *
                        ;* Girdi: HL = Ana buffer'da adresin başladığı yer                            *
                        ;* Çıktı: Başarılıysa -> Carry=0, DE=16-bit adres, HL=sayıdan sonraki karakter *
                        ;* Başarısızsa -> Carry=1 (hiç hex karakter bulunamadıysa)             *
                        ;******************************************************************************
                        ;******************************************************************************
                        ;* PARSE_HEX_ADDRESS (Sıfırdan Yazılmış Nihai Versiyon)                       *
                        ;* Açıklama: HL'nin gösterdiği yerden 1-4 haneli hex adresi okur.            *
                        ;* Sonucu sağa dayalı olarak hesaplar (Örn: "F" -> 000FH, "1F4" -> 01F4H).     *
                        ;* Girdi: HL = Ana buffer'da adresin başladığı yer                            *
                        ;* Çıktı: Başarılıysa -> Carry=0, DE=16-bit adres, HL=sayıdan sonraki karakter *
                        ;* Başarısızsa -> Carry=1 (hiç hex karakter bulunamadıysa)             *
                        ;******************************************************************************
01F2:                   PARSE_HEX_ADDRESS:
01F2: 110000   [10]         LD DE, 0          ; 1. Sonuç register'ı (DE) her zaman SIFIRDAN başlar.
01F5: 0604     [17]         LD B, 4           ; 2. En fazla 4 hane okumak için sayaç.
                        
01F7:                   PARSE_LOOP_FINAL:
01F7: 78       [ 4]         LD A, B
01F8: FE00     [11]         CP 0
01FA: CA3402   [21|21]      JP Z, PARSE_EXIT_FINAL ; Sayaç bittiyse (4 hane okunduysa) çık.
                        
01FD: 7E       [28]         LD A, (HL)        ; Buffer'dan sıradaki karakteri oku.
                        
                            ; --- KARAKTERİ DOĞRUDAN İÇERİDE ÇEVİR VE KONTROL ET ---
01FE: CD6E02   [45]         CALL UPPERCASE      ; 'a'-'f' ise 'A'-'F' yap.
0201: D5       [56]         PUSH DE             ; Ara sonucu (DE) ve sayacı (B) koru.
0202: C5       [67]         PUSH BC
                            
                            ; Gelen karakterin (A) sayısal değerini (0-15) bulalım.
0203: D630     [74]         SUB '0'
0205: DA3202   [84|84]      JP C, NOT_HEX_FINAL ; '0'dan küçükse hex değildir.
0208: FE0A     [91]         CP 10
020A: DA1D02   [101|101]    JP C, IS_VALID_HEX  ; 0-9 arasındaysa geçerlidir.
                            
020D: 7E       [108]        LD A, (HL)          ; Karakteri tekrar yükle (çünkü SUB '0' ile bozuldu)
020E: CD6E02   [125]        CALL UPPERCASE
0211: D641     [132]        SUB 'A'
0213: DA3202   [142|142]    JP C, NOT_HEX_FINAL ; 'A'dan küçükse hex değildir.
0216: FE06     [149]        CP 6                ; 'F'-'A' = 5. 6'dan büyük veya eşitse geçersiz.
0218: D23202   [159|159]    JP NC, NOT_HEX_FINAL
021B: C60A     [166]        ADD A, 10           ; 'A'-'F' ise 10-15 arası değere çevir.
                        
021D:                   IS_VALID_HEX:
                            ; Başarılı: A register'ı 0-15 arası doğru değeri içeriyor.
021D: C1       [10]         POP BC              ; Sayaçları geri al.
021E: D1       [20]         POP DE              ; Ara sonucu geri al.
                        
                            ; --- BASİTLEŞTİRİLMİŞ "KAYDIR VE EKLE" ---
                            ; a) Mevcut sonucu (DE) 16 ile çarp.
021F: E5       [31]         PUSH HL             ; Buffer işaretçisi HL'yi KORU!
0220: 626B     [39]         LD HL, DE
0222: 29       [50]         ADD HL, HL          ; HL = HL * 2
0223: 29       [61]         ADD HL, HL          ; HL = HL * 4
0224: 29       [72]         ADD HL, HL          ; HL = HL * 8
0225: 29       [83]         ADD HL, HL          ; HL = HL * 16
                            
                            ; b) Yeni haneyi ekle.
0226: 5F       [87]         LD E, A             ; Yeni haneyi (0-15) E'ye koy.
0227: 1600     [94]         LD D, 0             ; D'yi sıfırla.
0229: 19       [105]        ADD HL, DE          ; HL = (Eski Sonuç * 16) + Yeni Hane
022A: 545D     [113]        LD DE, HL           ; Nihai sonucu DE'ye geri al.
022C: E1       [123]        POP HL              ; Buffer işaretçisi HL'yi GERİ YÜKLE!
                            
022D: 23       [129]        INC HL              ; Ana buffer'da bir sonraki karaktere geç.
022E: 05       [133]        DEC B               ; Kalan hane hakkını azalt.
022F: C3F701   [143]        JP PARSE_LOOP_FINAL ; Döngüye devam et.
                        
0232:                   NOT_HEX_FINAL:
                            ; Başarısız: Karakter hex değil, sayı bitti demektir.
0232: C1       [10]         POP BC              ; Stack'i düzeltmek için register'ları geri al.
0233: D1       [20]         POP DE
                            ; Kasıtlı olarak döngüden çıkmak için PARSE_EXIT_FINAL'a atla.
                        
0234:                   PARSE_EXIT_FINAL:
                            ; Okunan hane sayısını bul: 4 - B'de kalan sayı
0234: 3E04     [ 7]         LD A, 4
0236: 90       [11]         SUB B
0237: FE00     [18]         CP 0
0239: CA3E02   [28|28]      JP Z, PARSE_ERROR_FINAL ; Hiç hane okunmadıysa hata.
                        
023C: B7       [32]         OR A                ; Başarı sinyali (Carry=0).
023D: C9       [42]         RET
                        
023E:                   PARSE_ERROR_FINAL:
023E: 37       [ 4]         SCF                 ; Hata sinyali (Carry=1).
023F: C9       [14]         RET
                        ;----------------ADRESS PARSER (FROM BUFFER) ENDED-----------------  
                        
                        ;******************************************************************************
                        ;* PARSE_HEX_BYTE ALT PROGRAMI (Yeni)                                         *
                        ;* Açıklama: HL'nin gösterdiği yerden 1 veya 2 haneli hex sayıyı okur.        *
                        ;* Sonucu 8-bit olarak A register'ına yazar.                                  *
                        ;* Girdi: HL = Ana buffer'da sayının başladığı yer                            *
                        ;* Çıktı: Başarılıysa -> Carry=0, A=8-bit değer, HL=sayıdan sonraki karakter   *
                        ;* Başarısızsa -> Carry=1 (hiç hex karakter bulunamadıysa)               *
                        ;******************************************************************************
                        ;******************************************************************************
                        ;* PARSE_HEX_BYTE (YENİ, GÜVENLİ ve BASİT Versiyon)                           *
                        ;* Açıklama: HL'nin gösterdiği yerden 1 veya 2 haneli hex sayıyı okur.        *
                        ;* Kendi içinde PUSH/POP kullanmadığı için yığını bozmaz.                     *
                        ;* Girdi: HL = Ana buffer'da sayının başladığı yer                            *
                        ;* Çıktı: Başarılıysa -> Carry=0, A=8-bit değer, HL=sayıdan sonraki karakter   *
                        ;* Başarısızsa -> Carry=1 (hiç hex karakter bulunamadıysa)               *
                        ;******************************************************************************
0240:                   PARSE_HEX_BYTE:
                            ; --- İlk haneyi okumayı dene ---
0240: CDC901   [17]         CALL PARSE_HEX_CHAR
0243: DA5A02   [27|27]      JP C, PARSE_BYTE_ERROR   ; Hiç hane yoksa doğrudan hata ver.
                        
0246: 47       [31]         LD B, A                  ; İlk hanenin değerini (0-15) B'de sakla.
                                                     ; HL, PARSE_HEX_CHAR tarafından ilerletildi.
                            
                            ; --- İkinci haneyi okumayı dene ---
                            ; NOT: HL zaten bir sonraki karakteri gösteriyor.
0247: CDC901   [48]         CALL PARSE_HEX_CHAR
                            
                            ; Eğer ikinci karakter hex değilse (Carry=1 ise), sonuç tek hanelidir.
024A: DA5702   [58|58]      JP C, PARSE_BYTE_DONE_1
                        
                            ; --- İki hane de bulundu. A'da ikinci hane, B'de ilk hane var. Birleştir. ---
024D: 4F       [62]         LD C, A                  ; İkinci haneyi C'de sakla.
024E: 78       [66]         LD A, B                  ; Birinci haneyi A'ya al.
024F: 87       [70]         ADD A, A                 ; A = A * 2
0250: 87       [74]         ADD A, A                 ; A = A * 4
0251: 87       [78]         ADD A, A                 ; A = A * 8
0252: 87       [82]         ADD A, A                 ; A = A * 16
0253: 81       [86]         ADD A, C                 ; A = (Birinci hane * 16) + İkinci hane
0254: C35802   [96]         JP PARSE_BYTE_DONE_2
                        
0257:                   PARSE_BYTE_DONE_1:
                            ; Sonuç tek haneli. Değer zaten B'deydi.
0257: 78       [ 4]         LD A, B
0258:                   PARSE_BYTE_DONE_2:
0258: B7       [ 4]         OR A                     ; Başarı sinyali (Carry=0).
0259: C9       [14]         RET
                        
025A:                   PARSE_BYTE_ERROR:
025A: 37       [ 4]         SCF                      ; Hata sinyali (Carry=1).
025B: C9       [14]         RET
                        
                        
                        
                        
                        ;-----------------hex byte parsing ended here----------------------
025C:                   CRLF: 
025C: 3E0A     [ 7]         LD A,0AH
025E: CDF10E   [24]         CALL TXD
0261: 3E0D     [31]         LD A,0DH
0263: CDF10E   [48]         CALL TXD
0266: C9       [58]         RET
                        
                        
0267:                   PROMPT:	
                            ; Yeşil  renkli prompt basalım
                        
                            ; --- 1. Adım: Kırmızı renk kodunu gönder ---
                        ;    LD A, 1BH           ; ESC karakteri
                        ;    CALL TXD
                        ;    LD A, '['           ; CSI karakteri
                        ;    CALL TXD
                        ;    LD A, '3'           ; Parametre '3'
                        ;    CALL TXD
                        ;    LD A, '2'           ; Parametre '1'
                        ;    CALL TXD
                        ;    LD A, 'm'           ; Komut karakteri 'm'
                        ;    CALL TXD
                        
                            ; --- 2. Adım: Asıl metni gönder ---
0267: 21C40F   [10]         LD HL,TABLE6 
026A: CDC802   [27]     	CALL PRINT
                        
                            ; --- 3. Adım: Rengi sıfırla (ÇOK ÖNEMLİ!) ---
                        ;    LD A, 1BH           ; ESC karakteri
                        ;    CALL TXD
                        ;    LD A, '['           ; CSI karakteri
                        ;    CALL TXD
                        ;    LD A, '0'           ; Sıfırlama parametresi '0'
                        ;    CALL TXD
                        ;    LD A, 'm'           ; Komut karakteri 'm'
                        ;    CALL TXD
                        
                        ; ... (Kırmızı renk ayarlanır ve "HATA!" yazılır) ...
                        
                        ; --- 3. Adım: Rengi NORMALE (Beyaz/Mavi) döndür ---
                        ;    LD A, 1BH           ; ESC
                        ;    CALL TXD
                        ;    LD A, '['
                        ;    CALL TXD
                        ;    LD A, '3'           ; Beyaz yazı parametresi (37)
                        ;    CALL TXD
                        ;    LD A, '7'
                        ;    CALL TXD
                        ;    LD A, ';'           ; Parametre ayırıcı
                        ;    CALL TXD
                        ;    LD A, '4'           ; Mavi zemin parametresi (44)
                        ;    CALL TXD
                        ;    LD A, '4'
                        ;    CALL TXD
                        ;    LD A, 'm'
                        ;    CALL TXD
                        
026D: C9       [37]     	RET
                        
                        ;UPPERCASE:     ;international keyboard   
                        
                        ;                CP 'a'            ; A 'a'dan küçük mü?
                        ;                JP C, DONEUP       ; Evetse, atla
                        ;                CP 'z'+1          ; A 'z'den büyük mü?
                        ;                JP NC, DONEUP       ; Hayırsa, atla
                        ;                SUB 0x20          ; Küçük harfse büyük harfe dönüştür
                        ;DONEUP:           RET               ; İşlemi bitir   
                        	
026E:                   UPPERCASE:
                            ; --- Adım 1: Türkçe 'ı' (noktasız i) için özel kontrol ---
026E: FEFD     [ 7]         CP      0FDH            ; Karakter 'ı' mı?
0270: C27802   [17|17]      JP      NZ, KONTROL_I_BUYUK ; Değilse, sonraki kontrole git
0273: 3E49     [24]         LD      A, 'I'          ; Evetse, 'I' yap
0275: C38E02   [34]         JP      DONEUP          ; Ve çık
                        
0278:                   KONTROL_I_BUYUK:
                            ; --- Adım 2: Türkçe 'İ' (büyük i) için özel kontrol ---
                            ; Shift/CapsLock ile 'i'ye basıldığında bu karakter gelir
0278: FEDD     [ 7]         CP      0DDH            ; Karakter 'İ' mi?
027A: C28202   [17|17]      JP      NZ, KONTROL_STD ; Değilse, standart kontrole git
027D: 3E49     [24]         LD      A, 'I'          ; Evetse, bunu da standart 'I' yap
027F: C38E02   [34]         JP      DONEUP          ; Ve çık
                        
0282:                   KONTROL_STD:
                            ; --- Adım 3: Standart 'a'-'z' aralığını kontrol et ---
0282: FE61     [ 7]         CP      'a'
                            ; 'a'dan küçükse (A-Z, 0-9, vs) dokunma Bu, 'I' harfinin de
                            ; değişmeden kalmasını sağlar
0284: DA8E02   [17|17]      JP      C, DONEUP
0287: FE7B     [24]         CP      'z' + 1
                            ; 'z'den büyükse (diğer özel karakterler) dokunma
0289: D28E02   [34|34]      JP      NC, DONEUP
                            
                            ; --- Adım 4: Güvenli çevirme işlemi ---
                            ; Bu aralık küçük 'i' harfini içerir ve onu 'I' harfine dönüştürür
028C: D620     [41]         SUB     020H
                        
028E:                   DONEUP:
028E: C9       [10]         RET    
                        	
                        
                        
                        
                        
                        ;----------------HELP-------------------------
028F:                   HELP:
028F: 23       [ 6]         INC HL
0290: 05       [10]         DEC B ; H RECEIVED, SO DECREASE POINTER AND COUNTER
0291: 7E       [17]         LD A,(HL)
0292: FE45     [24]         CP 'E'
0294: C2C101   [34|34]      JP NZ, ERROR_PARSER
0297: 23       [40]         INC HL
0298: 05       [44]         DEC B ; E RECEIVED, SO DECREASE POINTER AND COUNTER
0299: 7E       [51]         LD A,(HL)
029A: FE4C     [58]         CP 'L'
029C: C2C101   [68|68]      JP NZ, ERROR_PARSER
029F: 23       [74]         INC HL
02A0: 05       [78]         DEC B ; L RECEIVED, SO DECREASE POINTER AND COUNTER
02A1: 7E       [85]         LD A,(HL)
02A2: FE50     [92]         CP 'P'
02A4: C2C101   [102|102]    JP NZ, ERROR_PARSER
02A7: C3AA02   [112]        JP HELPEXEC
                        
02AA:                   HELPEXEC:	             ;HELP MSG
02AA: 21CB0F   [10]     	LD HL,TABLE21
02AD: CDC802   [27]     	CALL PRINT
                        	
                        	
02B0: C31B01   [37]     	JP INPUT
                            ;JP MA_IN
                        	
                        
                        	
                        
                        	
                        ;--------------DELAY 500MS---------------	
02B3:                   DE_LAY:
                        	
02B3: D5       [11]     	PUSH DE
02B4: F5       [22]     	PUSH AF
02B5: 1100FF   [32]     	LD DE,0FF00H
02B8:                   DISDELAY:
02B8: 1B       [ 6]     	DEC DE
02B9: 7A       [10]     	LD A,D
02BA: B3       [14]     	OR E
02BB: C2B802   [24|24]  	JP NZ,DISDELAY
02BE: D1       [34]     	POP DE
02BF: F1       [44]     	POP AF
02C0: C9       [54]     	RET
                        ;--------------------------------------	
                        ;--------------DELAY 1S----------------
02C1:                   DELAY_1S:
02C1: CDB302   [17]     	CALL DE_LAY
02C4: CDB302   [34]     	CALL DE_LAY
02C7: C9       [44]     	RET
                        ;--------------------------------------
                        
                        ;---------PRINT SUBROUTINE-------------
                        
                        	
02C8: 7E       [ 7]     PRINT:	LD A,(HL)
02C9: FE00     [14]     		CP 0
02CB: CAD502   [24|24]  		JP Z,PRINTDONE
02CE: CDF10E   [41]     		CALL TXD
02D1: 23       [47]     		INC HL
02D2: C2C802   [57|57]  		JP NZ,PRINT
02D5:                   PRINTDONE:		
02D5: C9       [10]     		RET
                        ;--------------------------------------	
                        
                        ;----------------INIT-8255----------------------------------
                        
02D6:                   	INIT8255:	;8255 @PORT 018H-01BH  ; 8255 BASE ADRESS: 08H
                        
02D6: CDB302   [17]         CALL DE_LAY ;WAIT 500MS FOR 8255 TO RESET
02D9: 3E92     [24]     	LD A,092H
02DB: D30B     [35]     	OUT (0BH),A 	;A(08H) AND B(09H)  C(0AH)  CONTROL: OBH
                        	
                        	;9B: A,B,C ALL INPUT
                        	;90: A INPUT, B AND C OUTPUT
                        	;80: A,B,C ALL OUTPUT
                        	;92: A AND B INPUT, C OUTPUT
                        	;82: A OUTPUT, B INPUT, C OUTPUT
02DD: C9       [45]         RET
                        
                            
                        ;----------------INIT-8251----------------------------------
                        
                        
                        
                        
                        
                        
                        
                        ;****************************************************************
                        ;* INIT8251 - 8251A UART Başlatma Rutini                        *
                        ;* Açıklama: Bu rutin, 8251A'yı güvenilir bir şekilde başlatır,  *
                        ;* senkronize eder ve standart 8-N-1 modunda çalışmaya hazırlar.*
                        ;****************************************************************
02DE:                   INIT8251:
                            ;; Adım 1: Senkronizasyon (Sync)
                            ;; 8251'in hangi modda olduğundan emin olmak için, önce üç kez
                            ;; 00h göndererek komut moduna girmeye zorlanır. Bu, tekrarlanan
                            ;; 40h göndermekten daha güvenilir bir yöntemdir.
02DE: 3E00     [ 7]         LD A, 00H
02E0: D301     [18]         OUT (UART_CTRL), A ;FORCED COMMAND MODE
02E2: 00       [22]         NOP
02E3: D301     [33]         OUT (UART_CTRL), A
02E5: 00       [37]         NOP
02E6: D301     [48]         OUT (UART_CTRL), A
02E8: 00       [52]         NOP
                        
                            ;; Adım 2: Dahili Reset (Internal Reset)
                            ;; Senkronizasyon sonrası, 40h komutu ile entegrenin iç durumu
                            ;; temizlenir ve Mod kelimesini almaya hazırlanır.
02E9: 3E40     [59]         LD A, UART_CMD_RESET ;40H
02EB: D301     [70]         OUT (UART_CTRL), A
02ED: 00       [74]         NOP
02EE: 00       [78]         NOP
                        
                            ;; Adım 3: Mod Kelimesinin Yazılması (Mode Word)
                            ;; UART'ın temel çalışma parametreleri ayarlanır.
02EF: 3E4E     [85]         LD A, UART_MODE_WORD ;04EH
02F1: D301     [96]         OUT (UART_CTRL), A
02F3: 00       [100]        NOP
02F4: 00       [104]        NOP
                        
                            ;; Adım 4: Komut Kelimesinin Yazılması (Command Word)
                            ;; Alıcı (Rx) ve verici (Tx) aktif edilir, hata bayrakları sıfırlanır.
02F5: 3E37     [111]        LD A, UART_CMD_WORD  ;037H
02F7: D301     [122]        OUT (UART_CTRL), A
                        
02F9: C9       [132]        RET
                          
                        	
                              
                        
                        	
                        
                        ;-------------HEXDUMP--------------------------
                        ;HEXDUMP OF INPUTTED MEMORY- +FFH
                        
                        	
02FA:                   HEXDUMP:
                            ;----------------------------------------------------
                            ; 1. "DUMP <adres>" komutunu ve adresi ayrıştıran bölüm
                            ;----------------------------------------------------
02FA: 23       [ 6]         INC HL
02FB: 05       [10]         DEC B       ; 'D' karakterini atla
02FC: 7E       [17]         LD A, (HL)
02FD: FE55     [24]         CP 'U'
02FF: C24206   [34|34]      JP NZ ,FROM_HEXDUMP
0302: 23       [40]         INC HL
0303: 05       [44]         DEC B       ; 'U' karakterini atla
0304: 7E       [51]         LD A, (HL)
0305: FE4D     [58]         CP 'M'
0307: C2C101   [68|68]      JP NZ, ERROR_PARSER
030A: 23       [74]         INC HL
030B: 05       [78]         DEC B       ; 'M' karakterini atla
030C: 7E       [85]         LD A, (HL)
030D: FE50     [92]         CP 'P'
030F: C2C101   [102|102]    JP NZ, ERROR_PARSER
0312: 23       [108]        INC HL
0313: 05       [112]        DEC B       ; 'P' karakterini atla
                        
0314: CDAE0C   [129]        CALL SKIP_SPACES
0317: CDF201   [146]        CALL PARSE_HEX_ADDRESS
031A: DAC101   [156|156]    JP C, ERROR_PARSER
031D: 626B     [164]        LD HL, DE   ; Başarılı! Dump başlangıç adresi HL'ye alındı.
                        
                            ;-----------------------------------------------------------------
                            ; 2. YENİ ve BASİT GÖRÜNTÜLEME DÖNGÜSÜ (Eskisiyle değiştirildi)
                            ;-----------------------------------------------------------------
031F:                   DUMP_PAGE_LOOP:
031F: 111000   [10]         LD DE, 16           ; Ekrana 16 satır bas
0322:                   DUMP_LINE_LOOP:
0322: CD4003   [17]         CALL DRAW_DUMP_LINE ; Bir satırı çizmesi için alt programı çağır
0325: 1B       [23]         DEC DE
0326: 7A       [27]         LD A, D
0327: B3       [31]         OR E
0328: C22203   [41|41]      JP NZ, DUMP_LINE_LOOP
                        
                            ;------------------------------------------------------------------
                            ; 3. TUŞ BEKLEME BÖLÜMÜ (Bu blok zaten vardı ve korundu)
                            ;------------------------------------------------------------------   
                        	
032B:                   CIKIS:	
032B: CDFD0E   [17]         CALL RXD
032E: FE1B     [24]     	CP 01BH
0330: CA1B01   [34|34]  	JP Z,INPUT		;ESC : EXIT TO MAIN MENU
0333: FE0D     [41]     	CP 0DH
0335: CA1F03   [51|51]  	JP Z, DUMP_PAGE_LOOP		;ENTER OR SPACE CONT. TO LISTING
0338: FE20     [58]     	CP 020H
033A: CA1F03   [68|68]  	JP Z, DUMP_PAGE_LOOP
033D: C32B03   [78]     	JP CIKIS
                        ;******************************************************************************
                        ;* DRAW_DUMP_LINE ALT PROGRAMI                                                *
                        ;* Açıklama: HL'nin gösterdiği adresten başlayarak tam bir hexdump satırı çizer.*
                        ;* Girdi: HL = Basılacak satırın başlangıç adresi                             *
                        ;* Çıktı: HL = Bir sonraki satırın adresi (HL + 16)                           *
                        ;* Korur: AF, BC, DE                                                          *
                        ;******************************************************************************
0340:                   DRAW_DUMP_LINE:
0340: F5       [11]         PUSH AF             ; Kullanılacak register'ları korumaya al
0341: C5       [22]         PUSH BC
0342: D5       [33]         PUSH DE
                        
                            ; --- Satır başı ve Adres basımı ---
0343: 3E0D     [40]         LD A, 0DH           ; Enter
0345: CDF10E   [57]         CALL TXD
0348: 3E0A     [64]         LD A, 0AH
034A: CDF10E   [81]         CALL TXD
034D: 7C       [85]         LD A, H             ; Adresin yüksek byte'ını bas
034E: CDAE0E   [102]        CALL HEXOUT
0351: 7D       [106]        LD A, L             ; Adresin düşük byte'ını bas
0352: CDAE0E   [123]        CALL HEXOUT
0355: 3E3A     [130]        LD A, ':'
0357: CDF10E   [147]        CALL TXD
035A: 3E20     [154]        LD A, ' '
035C: CDF10E   [171]        CALL TXD
                        
                            ; --- Hex dökümünü bas (16 byte) ---
035F: 0608     [178]        LD B, 8             ; İlk 8 byte
0361:                   DRAW_HEX1:
0361: 7E       [ 7]         LD A, (HL)
0362: CDAE0E   [24]         CALL HEXOUT
0365: 3E20     [31]         LD A, ' '
0367: CDF10E   [48]         CALL TXD
036A: 23       [54]         INC HL
036B: 05       [58]         DEC B
036C: C26103   [68|68]      JP NZ, DRAW_HEX1
                            
036F: 3E20     [75]         LD A, ' '           ; Ara boşluk
0371: CDF10E   [92]         CALL TXD
0374: 3E20     [99]         LD A, ' '
0376: CDF10E   [116]        CALL TXD
                            
0379: 0608     [123]        LD B, 8             ; Sonraki 8 byte
037B:                   DRAW_HEX2:
037B: 7E       [ 7]         LD A, (HL)
037C: CDAE0E   [24]         CALL HEXOUT
037F: 3E20     [31]         LD A, ' '
0381: CDF10E   [48]         CALL TXD
0384: 23       [54]         INC HL
0385: 05       [58]         DEC B
0386: C27B03   [68|68]      JP NZ, DRAW_HEX2
                            
