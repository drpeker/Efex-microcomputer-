                        ; -------- RX kuyruğunu boşalt --------
                        ;****************************************************************
                        ;* GETGARBAGE - Düzeltilmiş ve Zaman Aşımlı Sürüm               *
                        ;* Açıklama: Seri porttan gelen veri akışı kesilene kadar       *
                        ;* bekleyerek tüm "çöp" veriyi temizler.                        *
                        ;****************************************************************
0EA4:                   GETGARBAGE:
0EA4: D5       [11]         PUSH DE                 ; DE register'ını koru
0EA5: 11FFFF   [21]         LD DE, 0FFFFH           ; Zaman aşımı sayacını başlat (bu değer ayarlanabilir)
                        
0EA8:                   GARBAGE_WAIT_LOOP:
0EA8: CD8210   [17]         CALL RXNP               ; Karakter var mı diye beklemeden kontrol et (Sonuç Carry'de)
0EAB: D2B70E   [27|27]      JP NC, GARBAGE_CHAR_FOUND ; Carry=0 ise karakter bulundu, timeout'u sıfırla
                        
                            ; --- Karakter bulunamadı, zaman aşımını azalt ---
0EAE: 1B       [33]         DEC DE
0EAF: 7A       [37]         LD A, D
0EB0: B3       [41]         OR E
0EB1: C2A80E   [51|51]      JP NZ, GARBAGE_WAIT_LOOP ; Sayaç sıfır değilse beklemeye devam et
                            
                            ; --- Zaman aşımına ulaşıldı, veri akışı bitti demektir ---
0EB4: C3BD0E   [61]         JP GARBAGE_EXIT
                        
0EB7:                   GARBAGE_CHAR_FOUND:
                            ; Karakter bulundu (ve RXNP tarafından A'ya okundu).
                            ; Sadece zaman aşımı sayacını sıfırla ve daha fazla karakter var mı diye bekle.
0EB7: 11FFFF   [10]         LD DE, 0FFFFH           ; Sayacı yeniden doldur
0EBA: C3A80E   [20]         JP GARBAGE_WAIT_LOOP
                        
0EBD:                   GARBAGE_EXIT:
0EBD: D1       [10]         POP DE                  ; DE register'ını geri yükle
0EBE: C9       [20]         RET
                        
                         
                        	
                        	
                        		
                        ;	*********************************
                        ;	*				*
                        ;	*     Get Intel hex record	*
                        ;	*				*
                        ;	*********************************
                        
                        ;Short version - no checksum calculation.
                        
                        ;------------------- LOAD HEX (Checksum'lu) -------------------
                        
0EBF:                   INTLIN1:
0EBF: 3E00     [ 7]             LD      A,00H
0EC1: 3268FF   [20]             LD      (HEXLDREG),A
0EC4:                   INTLIN:
                                ; ':' gelene kadar bekle
0EC4:                   WAIT_COLON:
0EC4: CD7410   [17]             CALL    RXD
0EC7: FE1B     [24]             CP      1BH
0EC9: C8       [29|35]          RET     Z
0ECA: FE3A     [36]             CP      ':'
0ECC: C2C40E   [46|46]          JP      NZ, WAIT_COLON
                        
                                ; ----- Yeni kayıt: checksum akümülatörü sıfırla -----
0ECF: AF       [50]             XOR     A
0ED0: 5F       [54]             LD      E,A
                        
                                ; LENGTH
0ED1: CD610F   [71]             CALL    BYTERD
0ED4: 47       [75]             LD      B,A
0ED5: 83       [79]             ADD     A,E
0ED6: 5F       [83]             LD      E,A
                        
                                ; ADDRESS HI
0ED7: CD610F   [100]            CALL    BYTERD
0EDA: 67       [104]            LD      H,A
0EDB: 83       [108]            ADD     A,E
0EDC: 5F       [112]            LD      E,A
                        
                                ; ADDRESS LO
0EDD: CD610F   [129]            CALL    BYTERD
0EE0: 6F       [133]            LD      L,A
0EE1: 83       [137]            ADD     A,E
0EE2: 5F       [141]            LD      E,A
                        
                                ; Başlangıç adresini bir kez kaydet
0EE3: 3A68FF   [154]            LD      A,(HEXLDREG)
0EE6: FE01     [161]            CP      01H
0EE8: CAF30E   [171|171]        JP      Z, GOT_RECT
0EEB: 3E01     [178]            LD      A,01H
0EED: 3268FF   [191]            LD      (HEXLDREG),A
0EF0: 226AFF   [207]            LD      (LOADSTADR),HL
                        
0EF3:                   GOT_RECT:
                                ; RECORD TYPE
0EF3: CD610F   [17]             CALL    BYTERD
0EF6: 57       [21]             LD      D,A                  ; D = rectype
0EF7: 83       [25]             ADD     A,E
0EF8: 5F       [29]             LD      E,A
                        
0EF9: 7A       [33]             LD      A,D
0EFA: FE01     [40]             CP      01H
0EFC: CA2F0F   [50|50]          JP      Z, CHK_EOF           ; EOF → veri yok, checksum oku/doğrula
0EFF: FE00     [57]             CP      00H
0F01: C2170F   [67|67]          JP      NZ, SKIP_DATA        ; 00 dışı tip → yazma, sadece toplamla atla
                        
                        ; ---- DATA (type 00): B bayt yaz + toplam ----
0F04:                   DATAIN:
0F04: 78       [ 4]             LD      A,B
0F05: B7       [ 8]             OR      A
0F06: CA250F   [18|18]          JP      Z, READ_CHK
0F09: CD610F   [35]             CALL    BYTERD
0F0C: 77       [42]             LD      (HL),A
0F0D: 23       [48]             INC     HL
0F0E: 83       [52]             ADD     A,E
0F0F: 5F       [56]             LD      E,A
0F10: 05       [60]             DEC     B
0F11: C2040F   [70|70]          JP      NZ, DATAIN
0F14: C3250F   [80]             JP      READ_CHK
                        
                        ; ---- 00 dışı tipler: B baytı sadece toplamla ----
0F17:                   SKIP_DATA:
0F17: 78       [ 4]             LD      A,B
0F18: B7       [ 8]             OR      A
0F19: CA250F   [18|18]          JP      Z, READ_CHK
0F1C:                   SKIP_LOOPLL:
0F1C: CD610F   [17]             CALL    BYTERD
0F1F: 83       [21]             ADD     A,E
0F20: 5F       [25]             LD      E,A
0F21: 05       [29]             DEC     B
0F22: C21C0F   [39|39]          JP      NZ, SKIP_LOOPLL
                        
                        ; ---- CHECKSUM baytı: (E + chk) & 0xFF == 0 olmalı ----
0F25:                   READ_CHK:
0F25: CD610F   [17]             CALL    BYTERD              ; A = checksum
0F28: 83       [21]             ADD     A,E
0F29: C2390F   [31|31]          JP      NZ, LOAD_ERROR
0F2C: C3C40E   [41]             JP      INTLIN              ; sonraki kayda
                        
                        ; ---- EOF checksum’u da doğrula, sonra LOAD_ED ----
0F2F:                   CHK_EOF:
0F2F: CD610F   [17]             CALL    BYTERD
0F32: 83       [21]             ADD     A,E
0F33: C2390F   [31|31]          JP      NZ, LOAD_ERROR
0F36: C3790E   [41]             JP      LOAD_ED
                        
                        ; ---- Hata mesajı (istersen INPUT'a dön) ----
0F39:                   LOAD_ERROR:
0F39: 3E0D     [ 7]             LD      A,0DH
0F3B: CD6810   [24]             CALL    TXD
0F3E: 3E0A     [31]             LD      A,0AH
0F40: CD6810   [48]             CALL    TXD
0F43: 214F0F   [58]             LD      HL, TAB_LOAD_ERR
0F46: CDEB03   [75]             CALL    PRINT
0F49: CDA40E   [92]             CALL   GETGARBAGE   ;FLUSH_RX_ALL
0F4C: C31B01   [102]            JP      INPUT               ; ya da RET, akışına göre
                        
0F4F:                   TAB_LOAD_ERR:
0F4F: 0A0D                      .DB 0AH,0DH
0F51: 43686563                  .DB 'Checksum Error!'
0F55: 6B73756D          
0F59: 20457272          
0F5D: 6F7221            
0F60: 00                        .DB 00H
                        	
                        	
                           
                        
0F61:                   BYTERD:	
0F61: 1600     [ 7]         LD	D,000h		;Set up   ;	* Get 2 ASCII chrs as hex byte	*
0F63: CD6B0F   [24]     	CALL	HEXCON		;Get byte and convert to hex
0F66: 87       [28]     	ADD	A,A		;First nibble so
0F67: 87       [32]     	ADD	A,A		;multiply by 16
0F68: 87       [36]     	ADD	A,A		;
0F69: 87       [40]     	ADD	A,A		;
0F6A: 57       [44]     	LD	D,A		;Save hi nibble in D
0F6B:                   HEXCON:	
0F6B: CD7410   [17]         CALL	RXD		;Get next chr
0F6E: D630     [24]     	SUB	030h		;Makes '0'-'9' equal 0-9
0F70: FE0A     [31]     	CP	00Ah		;Is it 0-9 ?
0F72: DA770F   [41|41]  	JP	C,NALPHA	;If so miss next bit
0F75: D607     [48]     	SUB	007h		;Else convert alpha
0F77:                   NALPHA:	
0F77: B2       [ 4]         OR	D		;Add hi nibble back
0F78: C9       [14]     	RET			;
                        
                        
                        ;-------------------------Hex load finished-----------------
                        
                        ;--------------------------INTEL HEX SAVE ROUTINE
                        ;,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
                        ;INTEL HEX SAVE PROGRAM         ;
                        ;,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
                        ;	LD HL,START ADRESS
                        ;	LD DE, END ADRESS
                        	
                        ;--------------------------INTEL HEX SAVE ROUTINE (checksum'lu, sağlam)------
                        ;  Giriş: HL = başlangıç adresi
                        ;         DE = bitiş adresi (exclusive)
                        ;  Yan etkiler: HL ilerler; DE, kalan toplam uzunluğu tutar
                        ;-----------------------------------------------------------------------------
                        
0F79:                   INTSAVE:
                            ; DE = toplam uzunluk = (bitiş - başlangıç)
0F79: E5       [11]         PUSH HL
0F7A: EB       [15]         EX   DE,HL            ; HL = bitiş, DE = başlangıç
0F7B: B7       [19]         OR   A                ; carry temizle
0F7C: ED52     [34]         SBC  HL,DE            ; HL = bitiş - başlangıç
0F7E: EB       [38]         EX   DE,HL            ; DE = toplam byte sayısı
0F7F: E1       [48]         POP  HL               ; HL = başlangıç
                        
                            ; Başta bir CR/LF (opsiyonel)
0F80: 3E0D     [55]         LD   A,0DH
0F82: CD6810   [72]         CALL TXD
0F85: 3E0A     [79]         LD   A,0AH
0F87: CD6810   [96]         CALL TXD
                        
                        ;---- Kayıt üretim döngüsü ---------------------------------------------------
0F8A:                   SAVE_NEXT_REC:
0F8A: 7A       [ 4]         LD   A,D
0F8B: B7       [ 8]         OR   A
0F8C: 2005     [15|20]      JR   NZ, SAVE_LEN_16          ; 256'dan büyükse → 16
0F8E: 7B       [19]         LD   A,E
0F8F: FE10     [26]         CP   10H
0F91: 3804     [33|38]      JR   C,  SAVE_LEN_E           ; <16 ise → E
0F93:                   SAVE_LEN_16:
0F93: 0610     [ 7]         LD   B,10H
0F95: 1801     [19]         JR   SAVE_MAKE_REC
0F97:                   SAVE_LEN_E:
0F97: 47       [ 4]         LD   B,A                      ; B = bu satırın LL değeri
                        
                        ;---- Bir data kaydı yaz -----------------------------------------------------
0F98:                   SAVE_MAKE_REC:
                            ; satır checksum toplamını sıfırla
0F98: AF       [ 4]         XOR  A
0F99: 326CFF   [17]         LD   (SAVECHCK),A
                        
                            ; ':' yaz
0F9C: 3E3A     [24]         LD   A,':'
0F9E: CD6810   [41]         CALL TXD
                        
                            ; LL yaz + toplama ekle
0FA1: 78       [45]         LD   A,B
0FA2: CD2510   [62]         CALL HEXOUT
0FA5: 48       [66]         LD   C,B
0FA6: 3A6CFF   [79]         LD   A,(SAVECHCK)
0FA9: 81       [83]         ADD  A,C
0FAA: 326CFF   [96]         LD   (SAVECHCK),A
                        
                            ; Adres HI yaz + toplama ekle
0FAD: 7C       [100]        LD   A,H
0FAE: 4F       [104]        LD   C,A
0FAF: 3A6CFF   [117]        LD   A,(SAVECHCK)
0FB2: 81       [121]        ADD  A,C
0FB3: 326CFF   [134]        LD   (SAVECHCK),A
0FB6: 79       [138]        LD   A,C
0FB7: CD2510   [155]        CALL HEXOUT
                        
                            ; Adres LO yaz + toplama ekle
0FBA: 7D       [159]        LD   A,L
0FBB: 4F       [163]        LD   C,A
0FBC: 3A6CFF   [176]        LD   A,(SAVECHCK)
0FBF: 81       [180]        ADD  A,C
0FC0: 326CFF   [193]        LD   (SAVECHCK),A
0FC3: 79       [197]        LD   A,C
0FC4: CD2510   [214]        CALL HEXOUT
                        
                            ; Type = 00h (yaz + toplama; 0 eklemek fark etmez ama tutarlılık için)
0FC7: 3E00     [221]        LD   A,00H
0FC9: CD2510   [238]        CALL HEXOUT
                            ; toplam = toplam + 0 (değişmez)
                        
                            ; Bu satırın B byte verisini yaz
0FCC: CDFC0F   [255]        CALL YAZ
                        
                            ; Kalan veri var mı?
0FCF: 7A       [259]        LD   A,D
0FD0: B3       [263]        OR   E
0FD1: 20B7     [270|275]    JR   NZ, SAVE_NEXT_REC
                        
                        ;---- EOF kaydı --------------------------------------------------------------
0FD3:                   SAVE_EOF:
                            ; ':00000001FF' + CR/LF
0FD3: 3E3A     [ 7]         LD   A,':'
0FD5: CD6810   [24]         CALL TXD
0FD8: 3E00     [31]         LD   A,00H              ; LL
0FDA: CD2510   [48]         CALL HEXOUT
0FDD: 3E00     [55]         LD   A,00H              ; Addr hi
0FDF: CD2510   [72]         CALL HEXOUT
0FE2: 3E00     [79]         LD   A,00H              ; Addr lo
0FE4: CD2510   [96]         CALL HEXOUT
0FE7: 3E01     [103]        LD   A,01H              ; Type = 01 (EOF)
0FE9: CD2510   [120]        CALL HEXOUT
0FEC: 3EFF     [127]        LD   A,0FFH             ; Checksum = FF  (-(0+0+0+1))
0FEE: CD2510   [144]        CALL HEXOUT
0FF1: 3E0D     [151]        LD   A,0DH
0FF3: CD6810   [168]        CALL TXD
0FF6: 3E0A     [175]        LD   A,0AH
0FF8: CD6810   [192]        CALL TXD
0FFB: C9       [202]        RET
                        
                        ;---- B bayt veri yaz + checksum’a ekle + satır checksum üret ----------------
                        ;  Giriş: B = bu satırın uzunluğu (LL), HL = kaynak adres
                        ;         DE = kalan toplam uzunluk
                        ;  Çıkış: HL += B, DE -= B, B = 0
0FFC:                   YAZ:
0FFC:                   YAZ_LOOP:
0FFC: 78       [ 4]         LD   A,B
0FFD: B7       [ 8]         OR   A
0FFE: 2812     [15|20]      JR   Z,  YAZ_END
                        
1000: 7E       [22]         LD   A,(HL)             ; A = data
1001: 4F       [26]         LD   C,A                ; C = data (geçici)
                        
                            ; checksum += data
1002: 3A6CFF   [39]         LD   A,(SAVECHCK)
1005: 81       [43]         ADD  A,C
1006: 326CFF   [56]         LD   (SAVECHCK),A
                        
                            ; veriyi yaz
1009: 79       [60]         LD   A,C
100A: CD2510   [77]         CALL HEXOUT
                        
100D: 23       [83]         INC  HL
100E: 1B       [89]         DEC  DE
100F: 05       [93]         DEC  B
1010: 18EA     [105]        JR   YAZ_LOOP
                        
1012:                   YAZ_END:
                            ; checksum = iki’nin tümleyeni
1012: 3A6CFF   [13]         LD   A,(SAVECHCK)
1015: 2F       [17]         CPL
1016: 3C       [21]         INC  A
1017: CD2510   [38]         CALL HEXOUT
                        
                            ; satır sonu
101A: 3E0D     [45]         LD   A,0DH
101C: CD6810   [62]         CALL TXD
101F: 3E0A     [69]         LD   A,0AH
1021: CD6810   [86]         CALL TXD
1024: C9       [96]         RET
                        		
                        ;------------------------------SAVE FINISHED
                        
                        
                        
                        
                        ;----------------------HEXOUT--------------------------------------------
                        		
                        	
                        	
                        ;HEXOUT DO NOT CHANGES ANY REGISTER	
1025:                   HEXOUT:	
1025: C5       [11]         PUSH BC ; THIS SUBROUTINE SENDS CONTENTS OF ACC TO TERMINAL AS 
1026: D5       [22]     	PUSH DE ; TWO CHAR HEX VALUE (ASCII) 
1027: E5       [33]     	PUSH HL
1028: F5       [44]     	PUSH AF
                        	
1029: E6F0     [51]     	AND 0F0H
102B: 1F       [55]     	RRA
102C: 1F       [59]     	RRA
102D: 1F       [63]     	RRA
102E: 1F       [67]     	RRA
102F: 324AFF   [80]     	LD (HIGHNIBBLE),A  ;HIGH NIBBLE SYSTEM VARIABLE
1032: CD4410   [97]     	CALL HEXAS
                        	
1035: F1       [107]    	POP AF
1036: F5       [118]    	PUSH AF
1037: E60F     [125]    	AND 00FH
1039: 3248FF   [138]    	LD (LOWNIBBLE),A  ;LOW NIBBLE SYSTEM VARIABLE
103C: CD4410   [155]    	CALL HEXAS
                        	
103F: F1       [165]    	POP AF
1040: E1       [175]    	POP HL
1041: D1       [185]    	POP DE
1042: C1       [195]    	POP BC
                        	
1043: C9       [205]    	RET
                        	
1044:                   HEXAS:	
1044: 218F10   [10]         LD HL, TABLEX ; HEX NIBBLE TO ASCII CONVERTER
1047: 0600     [17]     	LD  B, 0	;ADDING HL WITH A
1049: 4F       [21]     	LD  C, A
104A: 09       [32]     	ADD HL, BC
104B: 7E       [39]            	LD A,(HL)
104C: CD6810   [56]     	CALL TXD ;TXD ROUTINE
104F: C9       [66]     	RET
                        		
1050:                   TABS_START:
1050: 00000000          	.DB 0,0,0,0,0,0,0,0
1054: 00000000          
1058: 00000000          	.DB 0,0,0,0,0,0,0,0
105C: 00000000          
1060: 00000000          	.DB 0,0,0,0,0,0,0,0
1064: 00000000          
                        		
                        
                        ;HEXOUT DO NOT CHANGES ANY REGISTER
                        ;-----------------------HEXOUT ENDED HERE------------------------
                        
                        ;TXD ROUTINE sends contents of A REGISTER  to serial out pin 
                        ;19200 BAUD, 8-N-1
                        
                        
1068: F5       [11]     TXD:    PUSH AF
1069: DB01     [11]     LOPTX: 	IN A,(01H)
106B: E601     [18]     	AND 001H     ;TXRDY?
106D: CA6910   [28|28]  	JP Z, LOPTX
1070: F1       [38]             POP AF
1071: D300     [49]     	OUT (00H),A
1073: C9       [59]             RET
                        	
                        ;----------------------------------------------------------------------------------
                        ;RXD ROUTINE receives 1 bayt from serial  to A REGISTER 
                        ;19200 BAUD, 8-N-1
                        
1074:                   RXD:    
1074: 3E37     [ 7]     	LD A,037H
1076: D301     [18]     	OUT (01),A ;ENABLE TX AND RX AND CLEAR ERR BITS
                        	
1078: DB01     [11]     LOPTR: 	IN A,(01H)
107A: E602     [18]     	AND 002H     ;TXRDY?
107C: CA7810   [28|28]  	JP Z, LOPTR
107F: DB00     [39]             IN A,(00H)   ;RECEIVE CHAR
1081: C9       [49]     	RET
                        	
                        ;****************************************************************
                        ;* RXNP - Non-Polling (Bloklamayan) Karakter Alma Rutini        *
                        ;* ------------------------------------------------------------ *
                        ;* Açıklama: 8251'in durumunu kontrol eder. Eğer okunacak bir    *
                        ;* karakter varsa, onu A register'ına alır ve Carry=0 *
                        ;* ile döner. Karakter yoksa, beklemeden Carry=1 ile  *
                        ;* döner.                                             *
                        ;* Çıktı    : Carry=0 ise A = Alınan karakter                    *
                        ;* Carry=1 ise A'nın içeriği anlamsızdır.             *
                        ;****************************************************************
1082:                   RXNP:
1082: DB01     [11]         IN A, (SER_STAT)        ; 8251 Durum portunu oku
1084: E602     [18]         AND RXRDY_MASK          ; RxRDY (Alıcı Hazır) bitini kontrol et
1086: CA8D10   [28|28]      JP Z, RXNP_NO_CHAR      ; Eğer bit 0 ise (Zero flag=1), okunacak karakter yok
                        
                            ; --- Karakter mevcut ---
1089: DB00     [39]         IN A, (SER_DATA)        ; Veri portundan karakteri A'ya oku
108B: B7       [43]         OR A                    ; Carry bayrağını temizle (Başarı durumu)
108C: C9       [53]         RET
                        
108D:                   RXNP_NO_CHAR:
108D: 37       [ 4]         SCF                     ; Carry bayrağını set et (Karakter yok durumu)
108E: C9       [14]         RET 
                        
                        
                        
