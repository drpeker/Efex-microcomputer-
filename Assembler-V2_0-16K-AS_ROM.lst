                        ;----------------INPUT HEX TO BYTE CONVERTER 2 BYTE OR 1 BYTE---------
0CC4:                   INTLINR:                   ;4 NIBBLE  INPUT   
0CC4: 212FFF   [10]     	LD HL, KEYINBUF -1 ; 
0CC7: 7E       [17]     	LD A,(HL)
0CC8: CDD90C   [34]     	CALL BYTERDR 
0CCB: 3235FF   [47]     	LD (KEYINRES + 1),A 
                        	
0CCE:                   INLIN2:	
0CCE: 2131FF   [10]         LD HL, KEYINBUF + 1       ;2 NIBBLE INPUT
0CD1: 7E       [17]     	LD A,(HL)
0CD2: CDD90C   [34]     	CALL BYTERDR 
0CD5: 3234FF   [47]     	LD (KEYINRES),A 
0CD8: C9       [57]     	RET
                        	
                        
0CD9:                   BYTERDR:
                        		
0CD9: 1600     [ 7]     	LD	D,000h		;Set up   ;	* Get 2 ASCII chrs as hex byte	*
0CDB: CDE30C   [24]     	CALL	HEXCONR		;Get byte and convert to hex
0CDE: 87       [28]     	ADD	A,A		;First nibble so
0CDF: 87       [32]     	ADD	A,A		;multiply by 16
0CE0: 87       [36]     	ADD	A,A		;
0CE1: 87       [40]     	ADD	A,A		;
0CE2: 57       [44]     	LD	D,A		;Save hi nibble in D
0CE3:                   HEXCONR:
                        	
0CE3: 23       [ 6]     	INC HL                ;HL:FF21
                        	
0CE4: 7E       [13]     	LD A, (HL)
                        		
                        	;CALL	RXD		;Get next chr
0CE5: D630     [20]     	SUB	030h		;Makes '0'-'9' equal 0-9
0CE7: FE0A     [27]     	CP	00Ah		;Is it 0-9 ?
0CE9: DAEE0C   [37|37]  	JP	C,NALPHAR	;If so miss next bit
0CEC: D607     [44]     	SUB	007h		;Else convert alpha
0CEE:                   NALPHAR:	
0CEE: B2       [ 4]     	OR	D		;Add hi nibble back
0CEF: C9       [14]     	RET			;RESULT STORED IN A REGISTER!
                        ;------------------BYTE CONVERTER FINISHED HERE---------------
                        
                        
                        ;---------------LOAD HEX FILE ROUTINE
0CF0:                   LOADERZ:
0CF0: 23       [ 6]         INC HL
0CF1: 05       [10]         DEC B ; H RECEIVED, SO DECREASE POINTER AND COUNTER
0CF2: 7E       [17]         LD A,(HL)
0CF3: FE4F     [24]         CP 'O'
0CF5: C2C101   [34|34]      JP NZ, ERROR_PARSER
0CF8: 23       [40]         INC HL
0CF9: 05       [44]         DEC B ; E RECEIVED, SO DECREASE POINTER AND COUNTER
0CFA: 7E       [51]         LD A,(HL)
0CFB: FE41     [58]         CP 'A'
0CFD: C2C101   [68|68]      JP NZ, ERROR_PARSER
0D00: 23       [74]         INC HL
0D01: 05       [78]         DEC B ; L RECEIVED, SO DECREASE POINTER AND COUNTER
0D02: 7E       [85]         LD A,(HL)
0D03: FE44     [92]         CP 'D'
0D05: C2C101   [102|102]    JP NZ, ERROR_PARSER
0D08: C30B0D   [112]        JP LOADEXEC
                        
0D0B:                   LOADEXEC:
                        	
                        	
0D0B: 21B40F   [10]     	LD HL,TABLE25         ;LOADING.. MSG
0D0E: CDC802   [27]     	CALL PRINT	
                        	
0D11: CD4A0D   [44]     	CALL INTLIN1
                        	
                        	
0D14:                   LOAD_ED:            ;load comlett, turn to main loop (INPUT)
                        	
0D14: 21A40F   [10]     	LD HL,TABLE2; FILE LOADED MESAGE
0D17: CDC802   [27]         CALL PRINT
                        	
0D1A: 3E24     [34]     	LD A,'$'
0D1C: CDF10E   [51]     	CALL TXD
                        	
0D1F: 2A6AFF   [67]     	LD HL,(LOADSTADR)  ;DOWNLOADED FILE START ADRESS
0D22: 7C       [71]     	LD A,H
0D23: CDAE0E   [88]     	CALL HEXOUT
0D26: 7D       [92]     	LD A,L
0D27: CDAE0E   [109]    	CALL HEXOUT
                        
0D2A: 3E0A     [116]    	LD A,0AH
0D2C: CDF10E   [133]    	CALL TXD
0D2F: 3E0D     [140]    	LD A,0DH
0D31: CDF10E   [157]    	CALL TXD
0D34: 3E07     [164]    	LD A,07H
0D36: CDF10E   [181]    	CALL TXD
                        
0D39: CD3F0D   [198]        CALL GETGARBAGE    ;CLEAR GARBAGE
                        	
0D3C: C31B01   [208]    	JP INPUT
                        	
                        
                        
                        ; -------- RX kuyruğunu boşalt --------
0D3F:                   GETGARBAGE:   ;RX ROUTINE WITHOUT POLL WAIT
                        
0D3F:                   fl_loop:
0D3F: DB01     [11]         in   a,(SER_STAT)
0D41: E602     [18]         and  RXRDY_MASK
0D43: 2804     [25|30]      jr   z,fl_done          ; hazır değil -> çık
0D45: DB00     [36]         in   a,(SER_DATA)        ; baytı çöpe at
0D47: 18F6     [48]         jr   fl_loop
0D49:                   fl_done:
0D49: C9       [10]         ret	
                        
                         
                        	
                        	
                        		
                        ;	*********************************
                        ;	*				*
                        ;	*     Get Intel hex record	*
                        ;	*				*
                        ;	*********************************
                        
                        ;Short version - no checksum calculation.
                        
                        ;------------------- LOAD HEX (Checksum'lu) -------------------
                        
0D4A:                   INTLIN1:
0D4A: 3E00     [ 7]             LD      A,00H
0D4C: 3268FF   [20]             LD      (HEXLDREG),A
0D4F:                   INTLIN:
                                ; ':' gelene kadar bekle
0D4F:                   WAIT_COLON:
0D4F: CDFD0E   [17]             CALL    RXD
0D52: FE1B     [24]             CP      1BH
0D54: C8       [29|35]          RET     Z
0D55: FE3A     [36]             CP      ':'
0D57: C24F0D   [46|46]          JP      NZ, WAIT_COLON
                        
                                ; ----- Yeni kayıt: checksum akümülatörü sıfırla -----
0D5A: AF       [50]             XOR     A
0D5B: 5F       [54]             LD      E,A
                        
                                ; LENGTH
0D5C: CDEA0D   [71]             CALL    BYTERD
0D5F: 47       [75]             LD      B,A
0D60: 83       [79]             ADD     A,E
0D61: 5F       [83]             LD      E,A
                        
                                ; ADDRESS HI
0D62: CDEA0D   [100]            CALL    BYTERD
0D65: 67       [104]            LD      H,A
0D66: 83       [108]            ADD     A,E
0D67: 5F       [112]            LD      E,A
                        
                                ; ADDRESS LO
0D68: CDEA0D   [129]            CALL    BYTERD
0D6B: 6F       [133]            LD      L,A
0D6C: 83       [137]            ADD     A,E
0D6D: 5F       [141]            LD      E,A
                        
                                ; Başlangıç adresini bir kez kaydet
0D6E: 3A68FF   [154]            LD      A,(HEXLDREG)
0D71: FE01     [161]            CP      01H
0D73: CA7E0D   [171|171]        JP      Z, GOT_RECT
0D76: 3E01     [178]            LD      A,01H
0D78: 3268FF   [191]            LD      (HEXLDREG),A
0D7B: 226AFF   [207]            LD      (LOADSTADR),HL
                        
0D7E:                   GOT_RECT:
                                ; RECORD TYPE
0D7E: CDEA0D   [17]             CALL    BYTERD
0D81: 57       [21]             LD      D,A                  ; D = rectype
0D82: 83       [25]             ADD     A,E
0D83: 5F       [29]             LD      E,A
                        
0D84: 7A       [33]             LD      A,D
0D85: FE01     [40]             CP      01H
0D87: CABA0D   [50|50]          JP      Z, CHK_EOF           ; EOF → veri yok, checksum oku/doğrula
0D8A: FE00     [57]             CP      00H
0D8C: C2A20D   [67|67]          JP      NZ, SKIP_DATA        ; 00 dışı tip → yazma, sadece toplamla atla
                        
                        ; ---- DATA (type 00): B bayt yaz + toplam ----
0D8F:                   DATAIN:
0D8F: 78       [ 4]             LD      A,B
0D90: B7       [ 8]             OR      A
0D91: CAB00D   [18|18]          JP      Z, READ_CHK
0D94: CDEA0D   [35]             CALL    BYTERD
0D97: 77       [42]             LD      (HL),A
0D98: 23       [48]             INC     HL
0D99: 83       [52]             ADD     A,E
0D9A: 5F       [56]             LD      E,A
0D9B: 05       [60]             DEC     B
0D9C: C28F0D   [70|70]          JP      NZ, DATAIN
0D9F: C3B00D   [80]             JP      READ_CHK
                        
                        ; ---- 00 dışı tipler: B baytı sadece toplamla ----
0DA2:                   SKIP_DATA:
0DA2: 78       [ 4]             LD      A,B
0DA3: B7       [ 8]             OR      A
0DA4: CAB00D   [18|18]          JP      Z, READ_CHK
0DA7:                   SKIP_LOOPLL:
0DA7: CDEA0D   [17]             CALL    BYTERD
0DAA: 83       [21]             ADD     A,E
0DAB: 5F       [25]             LD      E,A
0DAC: 05       [29]             DEC     B
0DAD: C2A70D   [39|39]          JP      NZ, SKIP_LOOPLL
                        
                        ; ---- CHECKSUM baytı: (E + chk) & 0xFF == 0 olmalı ----
0DB0:                   READ_CHK:
0DB0: CDEA0D   [17]             CALL    BYTERD              ; A = checksum
0DB3: 83       [21]             ADD     A,E
0DB4: C2C40D   [31|31]          JP      NZ, LOAD_ERROR
0DB7: C34F0D   [41]             JP      INTLIN              ; sonraki kayda
                        
                        ; ---- EOF checksum’u da doğrula, sonra LOAD_ED ----
0DBA:                   CHK_EOF:
0DBA: CDEA0D   [17]             CALL    BYTERD
0DBD: 83       [21]             ADD     A,E
0DBE: C2C40D   [31|31]          JP      NZ, LOAD_ERROR
0DC1: C3140D   [41]             JP      LOAD_ED
                        
                        ; ---- Hata mesajı (istersen INPUT'a dön) ----
0DC4:                   LOAD_ERROR:
0DC4: 3E0D     [ 7]             LD      A,0DH
0DC6: CDF10E   [24]             CALL    TXD
0DC9: 3E0A     [31]             LD      A,0AH
0DCB: CDF10E   [48]             CALL    TXD
0DCE: 21DA0D   [58]             LD      HL, TAB_LOAD_ERR
0DD1: CDC802   [75]             CALL    PRINT
0DD4: CD3F0D   [92]             CALL   GETGARBAGE   ;FLUSH_RX_ALL
0DD7: C31B01   [102]            JP      INPUT               ; ya da RET, akışına göre
                        
0DDA:                   TAB_LOAD_ERR:
0DDA: 0A0D                      .DB 0AH,0DH
0DDC: 43686563                  .DB 'Checksum Err!'
0DE0: 6B73756D          
0DE4: 20457272          
0DE8: 21                
0DE9: 00                        .DB 00H
                        	
                        	
                           
                        
0DEA:                   BYTERD:	
0DEA: 1600     [ 7]         LD	D,000h		;Set up   ;	* Get 2 ASCII chrs as hex byte	*
0DEC: CDF40D   [24]     	CALL	HEXCON		;Get byte and convert to hex
0DEF: 87       [28]     	ADD	A,A		;First nibble so
0DF0: 87       [32]     	ADD	A,A		;multiply by 16
0DF1: 87       [36]     	ADD	A,A		;
0DF2: 87       [40]     	ADD	A,A		;
0DF3: 57       [44]     	LD	D,A		;Save hi nibble in D
0DF4:                   HEXCON:	
0DF4: CDFD0E   [17]         CALL	RXD		;Get next chr
0DF7: D630     [24]     	SUB	030h		;Makes '0'-'9' equal 0-9
0DF9: FE0A     [31]     	CP	00Ah		;Is it 0-9 ?
0DFB: DA000E   [41|41]  	JP	C,NALPHA	;If so miss next bit
0DFE: D607     [48]     	SUB	007h		;Else convert alpha
0E00:                   NALPHA:	
0E00: B2       [ 4]         OR	D		;Add hi nibble back
0E01: C9       [14]     	RET			;
                        
                        
                        ;-------------------------Hex load finished-----------------
                        
                        ;--------------------------INTEL HEX SAVE ROUTINE
                        ;,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
                        ;INTEL HEX SAVE PROGRAM         ;
                        ;,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
                        ;	LD HL,START ADRESS
                        ;	LD DE, END ADRESS
                        	
                        ;--------------------------INTEL HEX SAVE ROUTINE (checksum'lu, sağlam)------
                        ;  Giriş: HL = başlangıç adresi
                        ;         DE = bitiş adresi (exclusive)
                        ;  Yan etkiler: HL ilerler; DE, kalan toplam uzunluğu tutar
                        ;-----------------------------------------------------------------------------
                        
0E02:                   INTSAVE:
                            ; DE = toplam uzunluk = (bitiş - başlangıç)
0E02: E5       [11]         PUSH HL
0E03: EB       [15]         EX   DE,HL            ; HL = bitiş, DE = başlangıç
0E04: B7       [19]         OR   A                ; carry temizle
0E05: ED52     [34]         SBC  HL,DE            ; HL = bitiş - başlangıç
0E07: EB       [38]         EX   DE,HL            ; DE = toplam byte sayısı
0E08: E1       [48]         POP  HL               ; HL = başlangıç
                        
                            ; Başta bir CR/LF (opsiyonel)
0E09: 3E0D     [55]         LD   A,0DH
0E0B: CDF10E   [72]         CALL TXD
0E0E: 3E0A     [79]         LD   A,0AH
0E10: CDF10E   [96]         CALL TXD
                        
                        ;---- Kayıt üretim döngüsü ---------------------------------------------------
0E13:                   SAVE_NEXT_REC:
0E13: 7A       [ 4]         LD   A,D
0E14: B7       [ 8]         OR   A
0E15: 2005     [15|20]      JR   NZ, SAVE_LEN_16          ; 256'dan büyükse → 16
0E17: 7B       [19]         LD   A,E
0E18: FE10     [26]         CP   10H
0E1A: 3804     [33|38]      JR   C,  SAVE_LEN_E           ; <16 ise → E
0E1C:                   SAVE_LEN_16:
0E1C: 0610     [ 7]         LD   B,10H
0E1E: 1801     [19]         JR   SAVE_MAKE_REC
0E20:                   SAVE_LEN_E:
0E20: 47       [ 4]         LD   B,A                      ; B = bu satırın LL değeri
                        
                        ;---- Bir data kaydı yaz -----------------------------------------------------
0E21:                   SAVE_MAKE_REC:
                            ; satır checksum toplamını sıfırla
0E21: AF       [ 4]         XOR  A
0E22: 326CFF   [17]         LD   (SAVECHCK),A
                        
                            ; ':' yaz
0E25: 3E3A     [24]         LD   A,':'
0E27: CDF10E   [41]         CALL TXD
                        
                            ; LL yaz + toplama ekle
0E2A: 78       [45]         LD   A,B
0E2B: CDAE0E   [62]         CALL HEXOUT
0E2E: 48       [66]         LD   C,B
0E2F: 3A6CFF   [79]         LD   A,(SAVECHCK)
0E32: 81       [83]         ADD  A,C
0E33: 326CFF   [96]         LD   (SAVECHCK),A
                        
                            ; Adres HI yaz + toplama ekle
0E36: 7C       [100]        LD   A,H
0E37: 4F       [104]        LD   C,A
0E38: 3A6CFF   [117]        LD   A,(SAVECHCK)
0E3B: 81       [121]        ADD  A,C
0E3C: 326CFF   [134]        LD   (SAVECHCK),A
0E3F: 79       [138]        LD   A,C
0E40: CDAE0E   [155]        CALL HEXOUT
                        
                            ; Adres LO yaz + toplama ekle
0E43: 7D       [159]        LD   A,L
0E44: 4F       [163]        LD   C,A
0E45: 3A6CFF   [176]        LD   A,(SAVECHCK)
0E48: 81       [180]        ADD  A,C
0E49: 326CFF   [193]        LD   (SAVECHCK),A
0E4C: 79       [197]        LD   A,C
0E4D: CDAE0E   [214]        CALL HEXOUT
                        
                            ; Type = 00h (yaz + toplama; 0 eklemek fark etmez ama tutarlılık için)
0E50: 3E00     [221]        LD   A,00H
0E52: CDAE0E   [238]        CALL HEXOUT
                            ; toplam = toplam + 0 (değişmez)
                        
                            ; Bu satırın B byte verisini yaz
0E55: CD850E   [255]        CALL YAZ
                        
                            ; Kalan veri var mı?
0E58: 7A       [259]        LD   A,D
0E59: B3       [263]        OR   E
0E5A: 20B7     [270|275]    JR   NZ, SAVE_NEXT_REC
                        
                        ;---- EOF kaydı --------------------------------------------------------------
0E5C:                   SAVE_EOF:
                            ; ':00000001FF' + CR/LF
0E5C: 3E3A     [ 7]         LD   A,':'
0E5E: CDF10E   [24]         CALL TXD
0E61: 3E00     [31]         LD   A,00H              ; LL
0E63: CDAE0E   [48]         CALL HEXOUT
0E66: 3E00     [55]         LD   A,00H              ; Addr hi
0E68: CDAE0E   [72]         CALL HEXOUT
0E6B: 3E00     [79]         LD   A,00H              ; Addr lo
0E6D: CDAE0E   [96]         CALL HEXOUT
0E70: 3E01     [103]        LD   A,01H              ; Type = 01 (EOF)
0E72: CDAE0E   [120]        CALL HEXOUT
0E75: 3EFF     [127]        LD   A,0FFH             ; Checksum = FF  (-(0+0+0+1))
0E77: CDAE0E   [144]        CALL HEXOUT
0E7A: 3E0D     [151]        LD   A,0DH
0E7C: CDF10E   [168]        CALL TXD
0E7F: 3E0A     [175]        LD   A,0AH
0E81: CDF10E   [192]        CALL TXD
0E84: C9       [202]        RET
                        
                        ;---- B bayt veri yaz + checksum’a ekle + satır checksum üret ----------------
                        ;  Giriş: B = bu satırın uzunluğu (LL), HL = kaynak adres
                        ;         DE = kalan toplam uzunluk
                        ;  Çıkış: HL += B, DE -= B, B = 0
0E85:                   YAZ:
0E85:                   YAZ_LOOP:
0E85: 78       [ 4]         LD   A,B
0E86: B7       [ 8]         OR   A
0E87: 2812     [15|20]      JR   Z,  YAZ_END
                        
0E89: 7E       [22]         LD   A,(HL)             ; A = data
0E8A: 4F       [26]         LD   C,A                ; C = data (geçici)
                        
                            ; checksum += data
0E8B: 3A6CFF   [39]         LD   A,(SAVECHCK)
0E8E: 81       [43]         ADD  A,C
0E8F: 326CFF   [56]         LD   (SAVECHCK),A
                        
                            ; veriyi yaz
0E92: 79       [60]         LD   A,C
0E93: CDAE0E   [77]         CALL HEXOUT
                        
0E96: 23       [83]         INC  HL
0E97: 1B       [89]         DEC  DE
0E98: 05       [93]         DEC  B
0E99: 18EA     [105]        JR   YAZ_LOOP
                        
0E9B:                   YAZ_END:
                            ; checksum = iki’nin tümleyeni
0E9B: 3A6CFF   [13]         LD   A,(SAVECHCK)
0E9E: 2F       [17]         CPL
0E9F: 3C       [21]         INC  A
0EA0: CDAE0E   [38]         CALL HEXOUT
                        
                            ; satır sonu
0EA3: 3E0D     [45]         LD   A,0DH
0EA5: CDF10E   [62]         CALL TXD
0EA8: 3E0A     [69]         LD   A,0AH
0EAA: CDF10E   [86]         CALL TXD
0EAD: C9       [96]         RET
                        		
                        ;------------------------------SAVE FINISHED
                        
                        
                        
                        
                        ;----------------------HEXOUT--------------------------------------------
                        		
                        	
                        	
                        ;HEXOUT DO NOT CHANGES ANY REGISTER	
0EAE:                   HEXOUT:	
0EAE: C5       [11]         PUSH BC ; THIS SUBROUTINE SENDS CONTENTS OF ACC TO TERMINAL AS 
0EAF: D5       [22]     	PUSH DE ; TWO CHAR HEX VALUE (ASCII) 
0EB0: E5       [33]     	PUSH HL
0EB1: F5       [44]     	PUSH AF
                        	
0EB2: E6F0     [51]     	AND 0F0H
0EB4: 1F       [55]     	RRA
0EB5: 1F       [59]     	RRA
0EB6: 1F       [63]     	RRA
0EB7: 1F       [67]     	RRA
0EB8: 324AFF   [80]     	LD (HIGHNIBBLE),A  ;HIGH NIBBLE SYSTEM VARIABLE
0EBB: CDCD0E   [97]     	CALL HEXAS
                        	
0EBE: F1       [107]    	POP AF
0EBF: F5       [118]    	PUSH AF
0EC0: E60F     [125]    	AND 00FH
0EC2: 3248FF   [138]    	LD (LOWNIBBLE),A  ;LOW NIBBLE SYSTEM VARIABLE
0EC5: CDCD0E   [155]    	CALL HEXAS
                        	
0EC8: F1       [165]    	POP AF
0EC9: E1       [175]    	POP HL
0ECA: D1       [185]    	POP DE
0ECB: C1       [195]    	POP BC
                        	
0ECC: C9       [205]    	RET
                        	
0ECD:                   HEXAS:	
0ECD: 210B0F   [10]         LD HL, TABLEX ; HEX NIBBLE TO ASCII CONVERTER
0ED0: 0600     [17]     	LD  B, 0	;ADDING HL WITH A
0ED2: 4F       [21]     	LD  C, A
0ED3: 09       [32]     	ADD HL, BC
0ED4: 7E       [39]            	LD A,(HL)
0ED5: CDF10E   [56]     	CALL TXD ;TXD ROUTINE
0ED8: C9       [66]     	RET
                        		
0ED9:                   TABS_START:
0ED9: 00000000          	.DB 0,0,0,0,0,0,0,0
0EDD: 00000000          
0EE1: 00000000          	.DB 0,0,0,0,0,0,0,0
0EE5: 00000000          
0EE9: 00000000          	.DB 0,0,0,0,0,0,0,0
0EED: 00000000          
                        		
                        
                        ;HEXOUT DO NOT CHANGES ANY REGISTER
                        ;-----------------------HEXOUT ENDED HERE------------------------
                        
                        ;TXD ROUTINE sends contents of A REGISTER  to serial out pin 
                        ;19200 BAUD, 8-N-1
                        
                        
0EF1: F5       [11]     TXD:    PUSH AF
0EF2: DB01     [11]     LOPTX: 	IN A,(01H)
0EF4: E601     [18]     	AND 001H     ;TXRDY?
0EF6: CAF20E   [28|28]  	JP Z, LOPTX
0EF9: F1       [38]             POP AF
0EFA: D300     [49]     	OUT (00H),A
0EFC: C9       [59]             RET
                        	
                        ;----------------------------------------------------------------------------------
                        ;RXD ROUTINE receives 1 bayt from serial  to A REGISTER 
                        ;19200 BAUD, 8-N-1
                        
0EFD:                   RXD:    
0EFD: 3E37     [ 7]     	LD A,037H
0EFF: D301     [18]     	OUT (01),A ;ENABLE TX AND RX AND CLEAR ERR BITS
                        	
0F01: DB01     [11]     LOPTR: 	IN A,(01H)
0F03: E602     [18]     	AND 002H     ;TXRDY?
0F05: CA010F   [28|28]  	JP Z, LOPTR
0F08: DB00     [39]             IN A,(00H)   ;RECEIVE CHAR
0F0A: C9       [49]     	RET
                        	
