0B63: 7C       [48]         LD A, H
0B64: CDAE0E   [65]         CALL HEXOUT
0B67: 7D       [69]         LD A, L
0B68: CDAE0E   [86]         CALL HEXOUT
0B6B: 3E3A     [93]         LD A, ':'
0B6D: CDF10E   [110]        CALL TXD
