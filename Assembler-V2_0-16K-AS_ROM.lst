0CA4: 23       [54]         INC HL
0CA5: 05       [58]         DEC B
0CA6: C29B0C   [68|68]      JP NZ, DRAW_EDIT_LOOP
                            
0CA9: D1       [78]         POP DE              ; Korunan register'ları geri yükle
0CAA: C1       [88]         POP BC
0CAB: F1       [98]         POP AF
