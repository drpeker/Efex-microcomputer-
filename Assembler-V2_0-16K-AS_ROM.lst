0F39: 23       [48]             INC     HL
0F3A: 83       [52]             ADD     A,E
0F3B: 5F       [56]             LD      E,A
0F3C: 05       [60]             DEC     B
0F3D: C2300F   [70|70]          JP      NZ, DATAIN
0F40: C3510F   [80]             JP      READ_CHK
                        
                        ; ---- 00 dışı tipler: B baytı sadece toplamla ----
0F43:                   SKIP_DATA:
0F43: 78       [ 4]             LD      A,B
0F44: B7       [ 8]             OR      A
0F45: CA510F   [18|18]          JP      Z, READ_CHK
0F48:                   SKIP_LOOPLL:
0F48: CD8D0F   [17]             CALL    BYTERD
0F4B: 83       [21]             ADD     A,E
0F4C: 5F       [25]             LD      E,A
0F4D: 05       [29]             DEC     B
0F4E: C2480F   [39|39]          JP      NZ, SKIP_LOOPLL
                        
                        ; ---- CHECKSUM baytı: (E + chk) & 0xFF == 0 olmalı ----
0F51:                   READ_CHK:
0F51: CD8D0F   [17]             CALL    BYTERD              ; A = checksum
0F54: 83       [21]             ADD     A,E
0F55: C2650F   [31|31]          JP      NZ, LOAD_ERROR
0F58: C3F00E   [41]             JP      INTLIN              ; sonraki kayda
                        
                        ; ---- EOF checksum’u da doğrula, sonra LOAD_ED ----
0F5B:                   CHK_EOF:
0F5B: CD8D0F   [17]             CALL    BYTERD
0F5E: 83       [21]             ADD     A,E
0F5F: C2650F   [31|31]          JP      NZ, LOAD_ERROR
0F62: C3A50E   [41]             JP      LOAD_ED
                        
                        ; ---- Hata mesajı (istersen INPUT'a dön) ----
0F65:                   LOAD_ERROR:
0F65: 3E0D     [ 7]             LD      A,0DH
0F67: CD9410   [24]             CALL    TXD
0F6A: 3E0A     [31]             LD      A,0AH
0F6C: CD9410   [48]             CALL    TXD
0F6F: 217B0F   [58]             LD      HL, TAB_LOAD_ERR
0F72: CDEB03   [75]             CALL    PRINT
0F75: CDD00E   [92]             CALL   GETGARBAGE   ;FLUSH_RX_ALL
0F78: C31B01   [102]            JP      INPUT               ; ya da RET, akışına göre
                        
0F7B:                   TAB_LOAD_ERR:
0F7B: 0A0D                      .DB 0AH,0DH
0F7D: 43686563                  .DB 'Checksum Error!'
0F81: 6B73756D          
0F85: 20457272          
0F89: 6F7221            
0F8C: 00                        .DB 00H
                        	
                        	
                           
                        
0F8D:                   BYTERD:	
0F8D: 1600     [ 7]         LD	D,000h		;Set up   ;	* Get 2 ASCII chrs as hex byte	*
0F8F: CD970F   [24]     	CALL	HEXCON		;Get byte and convert to hex
0F92: 87       [28]     	ADD	A,A		;First nibble so
0F93: 87       [32]     	ADD	A,A		;multiply by 16
0F94: 87       [36]     	ADD	A,A		;
0F95: 87       [40]     	ADD	A,A		;
0F96: 57       [44]     	LD	D,A		;Save hi nibble in D
0F97:                   HEXCON:	
0F97: CDA010   [17]         CALL	RXD		;Get next chr
0F9A: D630     [24]     	SUB	030h		;Makes '0'-'9' equal 0-9
0F9C: FE0A     [31]     	CP	00Ah		;Is it 0-9 ?
0F9E: DAA30F   [41|41]  	JP	C,NALPHA	;If so miss next bit
0FA1: D607     [48]     	SUB	007h		;Else convert alpha
0FA3:                   NALPHA:	
0FA3: B2       [ 4]         OR	D		;Add hi nibble back
0FA4: C9       [14]     	RET			;
                        
                        
                        ;-------------------------Hex load finished-----------------
                        
                        ;--------------------------INTEL HEX SAVE ROUTINE
                        ;,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
                        ;INTEL HEX SAVE PROGRAM         ;
                        ;,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
                        ;	LD HL,START ADRESS
                        ;	LD DE, END ADRESS
                        	
                        ;--------------------------INTEL HEX SAVE ROUTINE (checksum'lu, sağlam)------
                        ;  Giriş: HL = başlangıç adresi
                        ;         DE = bitiş adresi (exclusive)
                        ;  Yan etkiler: HL ilerler; DE, kalan toplam uzunluğu tutar
                        ;-----------------------------------------------------------------------------
                        
0FA5:                   INTSAVE:
                            ; DE = toplam uzunluk = (bitiş - başlangıç)
0FA5: E5       [11]         PUSH HL
0FA6: EB       [15]         EX   DE,HL            ; HL = bitiş, DE = başlangıç
0FA7: B7       [19]         OR   A                ; carry temizle
0FA8: ED52     [34]         SBC  HL,DE            ; HL = bitiş - başlangıç
0FAA: EB       [38]         EX   DE,HL            ; DE = toplam byte sayısı
0FAB: E1       [48]         POP  HL               ; HL = başlangıç
                        
                            ; Başta bir CR/LF (opsiyonel)
0FAC: 3E0D     [55]         LD   A,0DH
0FAE: CD9410   [72]         CALL TXD
0FB1: 3E0A     [79]         LD   A,0AH
0FB3: CD9410   [96]         CALL TXD
                        
                        ;---- Kayıt üretim döngüsü ---------------------------------------------------
0FB6:                   SAVE_NEXT_REC:
0FB6: 7A       [ 4]         LD   A,D
0FB7: B7       [ 8]         OR   A
0FB8: 2005     [15|20]      JR   NZ, SAVE_LEN_16          ; 256'dan büyükse → 16
0FBA: 7B       [19]         LD   A,E
0FBB: FE10     [26]         CP   10H
0FBD: 3804     [33|38]      JR   C,  SAVE_LEN_E           ; <16 ise → E
0FBF:                   SAVE_LEN_16:
0FBF: 0610     [ 7]         LD   B,10H
0FC1: 1801     [19]         JR   SAVE_MAKE_REC
0FC3:                   SAVE_LEN_E:
0FC3: 47       [ 4]         LD   B,A                      ; B = bu satırın LL değeri
                        
                        ;---- Bir data kaydı yaz -----------------------------------------------------
0FC4:                   SAVE_MAKE_REC:
                            ; satır checksum toplamını sıfırla
0FC4: AF       [ 4]         XOR  A
0FC5: 326CFF   [17]         LD   (SAVECHCK),A
                        
                            ; ':' yaz
0FC8: 3E3A     [24]         LD   A,':'
0FCA: CD9410   [41]         CALL TXD
                        
                            ; LL yaz + toplama ekle
0FCD: 78       [45]         LD   A,B
0FCE: CD5110   [62]         CALL HEXOUT
0FD1: 48       [66]         LD   C,B
0FD2: 3A6CFF   [79]         LD   A,(SAVECHCK)
0FD5: 81       [83]         ADD  A,C
0FD6: 326CFF   [96]         LD   (SAVECHCK),A
                        
                            ; Adres HI yaz + toplama ekle
0FD9: 7C       [100]        LD   A,H
0FDA: 4F       [104]        LD   C,A
0FDB: 3A6CFF   [117]        LD   A,(SAVECHCK)
0FDE: 81       [121]        ADD  A,C
0FDF: 326CFF   [134]        LD   (SAVECHCK),A
0FE2: 79       [138]        LD   A,C
0FE3: CD5110   [155]        CALL HEXOUT
                        
                            ; Adres LO yaz + toplama ekle
0FE6: 7D       [159]        LD   A,L
0FE7: 4F       [163]        LD   C,A
0FE8: 3A6CFF   [176]        LD   A,(SAVECHCK)
0FEB: 81       [180]        ADD  A,C
0FEC: 326CFF   [193]        LD   (SAVECHCK),A
0FEF: 79       [197]        LD   A,C
0FF0: CD5110   [214]        CALL HEXOUT
                        
                            ; Type = 00h (yaz + toplama; 0 eklemek fark etmez ama tutarlılık için)
0FF3: 3E00     [221]        LD   A,00H
0FF5: CD5110   [238]        CALL HEXOUT
                            ; toplam = toplam + 0 (değişmez)
                        
                            ; Bu satırın B byte verisini yaz
0FF8: CD2810   [255]        CALL YAZ
                        
                            ; Kalan veri var mı?
0FFB: 7A       [259]        LD   A,D
0FFC: B3       [263]        OR   E
0FFD: 20B7     [270|275]    JR   NZ, SAVE_NEXT_REC
                        
                        ;---- EOF kaydı --------------------------------------------------------------
0FFF:                   SAVE_EOF:
                            ; ':00000001FF' + CR/LF
0FFF: 3E3A     [ 7]         LD   A,':'
1001: CD9410   [24]         CALL TXD
1004: 3E00     [31]         LD   A,00H              ; LL
1006: CD5110   [48]         CALL HEXOUT
1009: 3E00     [55]         LD   A,00H              ; Addr hi
100B: CD5110   [72]         CALL HEXOUT
100E: 3E00     [79]         LD   A,00H              ; Addr lo
1010: CD5110   [96]         CALL HEXOUT
1013: 3E01     [103]        LD   A,01H              ; Type = 01 (EOF)
1015: CD5110   [120]        CALL HEXOUT
1018: 3EFF     [127]        LD   A,0FFH             ; Checksum = FF  (-(0+0+0+1))
101A: CD5110   [144]        CALL HEXOUT
101D: 3E0D     [151]        LD   A,0DH
101F: CD9410   [168]        CALL TXD
1022: 3E0A     [175]        LD   A,0AH
1024: CD9410   [192]        CALL TXD
1027: C9       [202]        RET
                        
                        ;---- B bayt veri yaz + checksum’a ekle + satır checksum üret ----------------
                        ;  Giriş: B = bu satırın uzunluğu (LL), HL = kaynak adres
                        ;         DE = kalan toplam uzunluk
                        ;  Çıkış: HL += B, DE -= B, B = 0
1028:                   YAZ:
1028:                   YAZ_LOOP:
1028: 78       [ 4]         LD   A,B
1029: B7       [ 8]         OR   A
102A: 2812     [15|20]      JR   Z,  YAZ_END
                        
102C: 7E       [22]         LD   A,(HL)             ; A = data
102D: 4F       [26]         LD   C,A                ; C = data (geçici)
                        
                            ; checksum += data
102E: 3A6CFF   [39]         LD   A,(SAVECHCK)
1031: 81       [43]         ADD  A,C
1032: 326CFF   [56]         LD   (SAVECHCK),A
                        
                            ; veriyi yaz
1035: 79       [60]         LD   A,C
1036: CD5110   [77]         CALL HEXOUT
                        
1039: 23       [83]         INC  HL
103A: 1B       [89]         DEC  DE
103B: 05       [93]         DEC  B
103C: 18EA     [105]        JR   YAZ_LOOP
                        
103E:                   YAZ_END:
                            ; checksum = iki’nin tümleyeni
103E: 3A6CFF   [13]         LD   A,(SAVECHCK)
1041: 2F       [17]         CPL
1042: 3C       [21]         INC  A
1043: CD5110   [38]         CALL HEXOUT
                        
                            ; satır sonu
1046: 3E0D     [45]         LD   A,0DH
1048: CD9410   [62]         CALL TXD
104B: 3E0A     [69]         LD   A,0AH
104D: CD9410   [86]         CALL TXD
1050: C9       [96]         RET
                        		
                        ;------------------------------SAVE FINISHED
                        
                        
                        
                        
                        ;----------------------HEXOUT--------------------------------------------
                        		
                        	
                        	
                        ;HEXOUT DO NOT CHANGES ANY REGISTER	
1051:                   HEXOUT:	
1051: C5       [11]         PUSH BC ; THIS SUBROUTINE SENDS CONTENTS OF ACC TO TERMINAL AS 
1052: D5       [22]     	PUSH DE ; TWO CHAR HEX VALUE (ASCII) 
1053: E5       [33]     	PUSH HL
1054: F5       [44]     	PUSH AF
                        	
1055: E6F0     [51]     	AND 0F0H
1057: 1F       [55]     	RRA
1058: 1F       [59]     	RRA
1059: 1F       [63]     	RRA
105A: 1F       [67]     	RRA
105B: 324AFF   [80]     	LD (HIGHNIBBLE),A  ;HIGH NIBBLE SYSTEM VARIABLE
105E: CD7010   [97]     	CALL HEXAS
                        	
1061: F1       [107]    	POP AF
1062: F5       [118]    	PUSH AF
1063: E60F     [125]    	AND 00FH
1065: 3248FF   [138]    	LD (LOWNIBBLE),A  ;LOW NIBBLE SYSTEM VARIABLE
1068: CD7010   [155]    	CALL HEXAS
                        	
106B: F1       [165]    	POP AF
106C: E1       [175]    	POP HL
106D: D1       [185]    	POP DE
106E: C1       [195]    	POP BC
                        	
106F: C9       [205]    	RET
                        	
1070:                   HEXAS:	
1070: 21BB10   [10]         LD HL, TABLEX ; HEX NIBBLE TO ASCII CONVERTER
1073: 0600     [17]     	LD  B, 0	;ADDING HL WITH A
1075: 4F       [21]     	LD  C, A
1076: 09       [32]     	ADD HL, BC
1077: 7E       [39]            	LD A,(HL)
1078: CD9410   [56]     	CALL TXD ;TXD ROUTINE
107B: C9       [66]     	RET
                        		
107C:                   TABS_START:
107C: 00000000          	.DB 0,0,0,0,0,0,0,0
1080: 00000000          
1084: 00000000          	.DB 0,0,0,0,0,0,0,0
1088: 00000000          
108C: 00000000          	.DB 0,0,0,0,0,0,0,0
1090: 00000000          
                        		
                        
                        ;HEXOUT DO NOT CHANGES ANY REGISTER
                        ;-----------------------HEXOUT ENDED HERE------------------------
                        
                        ;TXD ROUTINE sends contents of A REGISTER  to serial out pin 
                        ;19200 BAUD, 8-N-1
                        
                        
1094: F5       [11]     TXD:    PUSH AF
1095: DB01     [11]     LOPTX: 	IN A,(01H)
1097: E601     [18]     	AND 001H     ;TXRDY?
1099: CA9510   [28|28]  	JP Z, LOPTX
109C: F1       [38]             POP AF
109D: D300     [49]     	OUT (00H),A
109F: C9       [59]             RET
                        	
                        ;----------------------------------------------------------------------------------
                        ;RXD ROUTINE receives 1 bayt from serial  to A REGISTER 
                        ;19200 BAUD, 8-N-1
                        
10A0:                   RXD:    
10A0: 3E37     [ 7]     	LD A,037H
10A2: D301     [18]     	OUT (01),A ;ENABLE TX AND RX AND CLEAR ERR BITS
                        	
10A4: DB01     [11]     LOPTR: 	IN A,(01H)
10A6: E602     [18]     	AND 002H     ;TXRDY?
10A8: CAA410   [28|28]  	JP Z, LOPTR
10AB: DB00     [39]             IN A,(00H)   ;RECEIVE CHAR
10AD: C9       [49]     	RET
                        	
                        ;****************************************************************
                        ;* RXNP - Non-Polling (Bloklamayan) Karakter Alma Rutini        *
                        ;* ------------------------------------------------------------ *
                        ;* Açıklama: 8251'in durumunu kontrol eder. Eğer okunacak bir    *
                        ;* karakter varsa, onu A register'ına alır ve Carry=0 *
                        ;* ile döner. Karakter yoksa, beklemeden Carry=1 ile  *
                        ;* döner.                                             *
                        ;* Çıktı    : Carry=0 ise A = Alınan karakter                    *
                        ;* Carry=1 ise A'nın içeriği anlamsızdır.             *
                        ;****************************************************************
10AE:                   RXNP:
10AE: DB01     [11]         IN A, (SER_STAT)        ; 8251 Durum portunu oku
10B0: E602     [18]         AND RXRDY_MASK          ; RxRDY (Alıcı Hazır) bitini kontrol et
10B2: CAB910   [28|28]      JP Z, RXNP_NO_CHAR      ; Eğer bit 0 ise (Zero flag=1), okunacak karakter yok
                        
                            ; --- Karakter mevcut ---
10B5: DB00     [39]         IN A, (SER_DATA)        ; Veri portundan karakteri A'ya oku
10B7: B7       [43]         OR A                    ; Carry bayrağını temizle (Başarı durumu)
10B8: C9       [53]         RET
                        
10B9:                   RXNP_NO_CHAR:
10B9: 37       [ 4]         SCF                     ; Carry bayrağını set et (Karakter yok durumu)
10BA: C9       [14]         RET 
                        
                        
                        
