0E6A:                   BYTERDR:
                        		
0E6A: 1600     [ 7]     	LD	D,000h		;Set up   ;	* Get 2 ASCII chrs as hex byte	*
0E6C: CD740E   [24]     	CALL	HEXCONR		;Get byte and convert to hex
0E6F: 87       [28]     	ADD	A,A		;First nibble so
0E70: 87       [32]     	ADD	A,A		;multiply by 16
0E71: 87       [36]     	ADD	A,A		;
0E72: 87       [40]     	ADD	A,A		;
0E73: 57       [44]     	LD	D,A		;Save hi nibble in D
0E74:                   HEXCONR:
                        	
0E74: 23       [ 6]     	INC HL                ;HL:FF21
                        	
0E75: 7E       [13]     	LD A, (HL)
                        		
                        	;CALL	RXD		;Get next chr
0E76: D630     [20]     	SUB	030h		;Makes '0'-'9' equal 0-9
0E78: FE0A     [27]     	CP	00Ah		;Is it 0-9 ?
0E7A: DA7F0E   [37|37]  	JP	C,NALPHAR	;If so miss next bit
0E7D: D607     [44]     	SUB	007h		;Else convert alpha
0E7F:                   NALPHAR:	
0E7F: B2       [ 4]     	OR	D		;Add hi nibble back
0E80: C9       [14]     	RET			;RESULT STORED IN A REGISTER!
                        ;------------------BYTE CONVERTER FINISHED HERE---------------
                        
                        
