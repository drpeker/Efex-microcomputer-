0B72: CDF10E   [134]        CALL TXD
0B75: E1       [144]        POP HL              ; Basılacak asıl adresi geri al
                        
                            ; 16 byte'lık veriyi hex olarak bas
0B76: 0610     [151]        LD B, 16
