                        ;******************************************************************************
                        ;* SİSTEM DEĞİŞKENLERİ (Yeniden Düzenlenmiş ve Word-Aligned) V2.0              *
                        ;* Bellek Haritası: FF00H'dan başlar. Tüm değişkenler 2 byte'a hizalanmıştır.  *
                        ;******************************************************************************
                        
                        ; --- ANA BUFFER'LAR ---
FF00:                   COMINBUF        EQU     0FF00H      ; Ana komut giriş buffer'ı (32 byte)
FF20:                   CODEBUF         EQU     0FF20H      ; Assembler için makine kodu buffer'ı (16 byte)
FF30:                   KEYINBUF        EQU     0FF30H      ; Eski hex giriş için buffer (4 byte)
FF34:                   KEYINRES        EQU     0FF34H      ; Eski hex giriş sonucu (4 byte)
                        
                        ; --- GENEL AMAÇLI VE PARSER DEĞİŞKENLERİ (Tümü 2 Byte) ---
                        ; (FF40H adresinden başlar)
FF40:                   LINELENGHT      EQU     0FF40H      ; COMINBUF'taki komutun uzunluğu
FF42:                   DATAINP         EQU     0FF42H      ; Tek byte'lık hex giriş sonucu
FF44:                   ADRSINP         EQU     0FF44H      ; Çift byte'lık hex giriş sonucu
FF46:                   HEXREG          EQU     0FF46H      ; RUN gibi komutlar için geçici adres
FF48:                   LOWNIBBLE       EQU     0FF48H      ; HEXOUT için geçici düşük nibble
FF4A:                   HIGHNIBBLE      EQU     0FF4AH      ; HEXOUT için geçici yüksek nibble
                        
                        ; --- ASSEMBLER DEĞİŞKENLERİ (Tümü 2 Byte) ---
FF4C:                   TABFINDAD       EQU     0FF4CH      ; Assembler tablo arama adresi
FF4E:                   ASADR           EQU     0FF4EH      ; Mevcut assembly adresi
FF50:                   ASADCODE        EQU     0FF50H      ; Kodu yazılacak assembly adresi
FF52:                   OPBYTECNT       EQU     0FF52H      ; Assembler operand byte sayacı
FF54:                   DIYEZDOLAR      EQU     0FF54H      ; Assembler operand türü (#,$)
FF56:                   CODEBUFLEN      EQU     0FF56H      ; CODEBUF'taki kodun uzunluğu
                        
                        ; --- DISASSEMBLER DEĞİŞKENLERİ (Tümü 2 Byte) ---
FF58:                   DISADDR         EQU     0FF58H      ; Sökülmekte olan adres
FF5A:                   DISFINDAD       EQU     0FF5AH      ; Kod tablosunda bulunan adres
FF5C:                   DISCODELEN      EQU     0FF5CH      ; Komutun makine kodu uzunluğu
FF5E:                   MNESTAD         EQU     0FF5EH      ; Mnemonik başlangıç adresi
FF60:                   MNENDAD         EQU     0FF60H      ; Mnemonik bitiş adresi
FF62:                   OPERAND         EQU     0FF62H      ; Komutun operand adresi
FF64:                   MNELEN          EQU     0FF64H      ; Mnemonik metin uzunluğu
FF66:                   OPCNT           EQU     0FF66H      ; Disassembler operand sayacı
                        
                        ; --- HEX YÜKLEME/KAYDETME DEĞİŞKENLERİ (Tümü 2 Byte) ---
FF68:                   HEXLDREG        EQU     0FF68H      ; Hex load'un ilk adresi kaydedildi mi?
FF6A:                   LOADSTADR       EQU     0FF6AH      ; Yüklenen programın başlangıç adresi
FF6C:                   SAVECHCK        EQU     0FF6CH      ; Hex save için checksum sayacı
                        
                        ; --- DİĞER SİSTEM İŞARETÇİLERİ (FARKLI BELLEK BÖLGELERİ) ---
                        ; Bu değişkenler çakışmadığı için orijinal yerlerinde bırakılmıştır.
FF70:                   NEXTCODE        EQU     0FF70H      ; Disassembler için sonraki satır adresi
FF72:                   SECTORC         EQU     0FF72H      ; Disassembler ekran satır sayacı
FF76:                   EDITADR         EQU     0FF76H      ; EDIT komutunun mevcut adresi
                        ;INTADRS         EQU     0FF78H      ; Kullanıcı interrupt vektör adresi
                        
FF7A:                   STARTADR        EQU     0FF7AH      ;command input variable
FF7C:                   ENDADR          EQU     0FF7CH      ;command input variable
FF7E:                   COMMVAR         EQU     0FF7EH      ;COMMAND INPUT VARIABLE (2 BYTE)
                        ;------------------------------------------------------------------------
                        ;XXXX           EQU     0FF80H      ; FIRST EMPTY SYSTEM VARIABLE!
FF80:                   INTADRS			EQU		0FF80H 		; NEW INTERRUPT VECTOR
FF82:                   NMIADRS			EQU     0FF82H		; NEW NMI VECTOR
                        
                        
                        ; --- STACK İŞARETÇİSİ ---
                        ; Bu bir değişken alanı değil, sadece bir değerdir. Değişkenlerle çakışmaz.
FEFF:                   STACKPOINT      EQU     0FEFFH      ; Yığın (stack) başlangıç noktası
                        ;STACK POINTER;
                        ; -------- UART sabitleri --------
0000:                   SER_DATA   EQU 00h
0001:                   SER_STAT   EQU 01h
0002:                   RXRDY_MASK EQU 02h   ; 8251: bit1 = RxRDY
                        
                        ;****************************************************************
                        ;* 8251A UART SABİT TANIMLAMALARI                 *
                        ;****************************************************************
0000:                   UART_DATA       EQU     000H    ; 8251 Veri Portu
0001:                   UART_CTRL       EQU     001H    ; 8251 Kontrol/Durum Portu
                        
                        ; --- Başlatma Komutları ---
0040:                   UART_CMD_RESET  EQU     040H    ; Dahili Reset Komutu
004E:                   UART_MODE_WORD  EQU     04EH    ; MODE: 8-bit data, No Parity, 1 Stop Bit, x16 Clock
0037:                   UART_CMD_WORD   EQU     037H    ; COMMAND: Tx/Rx Enable, Error Reset, RTS/DTR Low
                        
                        
                        	
                        
                        ;-------------------------------------------------
                        ;8 mhz System clock,1.834 MHz  uart tx/rx clock (DIVIDE BY 16), 32k rom, 32k ram
                        ;PORT 00:UART data, port 01 control/status
                        ;PORT 08:8255    08 input,  09 and 0A output
                        ;
0000:                   	.org 00000H    ;CHANGE 0000 TO RUN IN ROM!
                        	;
0000: C30001   [10]     	JP BASLA
                            ;JP GREET
                        	
                        ;-----------------------------------------------------------------------------------
                        ;   UNCOMMENT THIS TO RUN IN ROM
                        
                        	.ORG 0038H               ;CHANGEABLE INTERRUPT SUBROUTINE
0038: 2A80FF   [26]     	LD HL,(INTADRS)
003B: E9       [30]     	JP (HL)
                        	
                        ;-------------------------------------------------------------------------------------
                        
                        ;-----------------------------------------------------------------------------------
                        ;   UNCOMMENT THIS TO RUN IN ROM
                        
                        	.ORG 0066H               ;CHANGEABLE INTERRUPT SUBROUTINE
0066: 2A82FF   [46]     	LD HL,(NMIADRS)
0069: E9       [50]     	JP (HL)
                        	
                        ;----------------------------------------------------------------------
                        
                        
                        
                        	
                             .ORG 0100H
                        
