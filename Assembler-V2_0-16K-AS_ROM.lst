                        ;******************************************************************************
                        ;* DRAW_EDIT_LINE_SIMPLE ALT PROGRAMI                                         *
                        ;* Açıklama: SADECE EDIT komutu için, HL'nin gösterdiği adresten başlayarak,   *
                        ;* adresi ve 16 byte'lık hex veriyi tek bir satırda basar.                      *
                        ;* Girdi: HL = Basılacak satırın başlangıç adresi                             *
                        ;* Çıktı: HL = HL + 16 (Bir sonraki satırın başlangıcı)                       *
                        ;* Korur: AF, BC, DE                                                          *
                        ;******************************************************************************
0C82:                   DRAW_EDIT_LINE_SIMPLE:
0C82: F5       [11]         PUSH AF             ; Kullanılacak register'ları koru
0C83: C5       [22]         PUSH BC
0C84: D5       [33]         PUSH DE
                            
                            ; Adresi basarken HL'yi geçici olarak koru
0C85: E5       [44]         PUSH HL
0C86: 7C       [48]         LD A, H
0C87: CD2510   [65]         CALL HEXOUT
0C8A: 7D       [69]         LD A, L
0C8B: CD2510   [86]         CALL HEXOUT
0C8E: 3E3A     [93]         LD A, ':'
0C90: CD6810   [110]        CALL TXD
0C93: 3E20     [117]        LD A, ' '
0C95: CD6810   [134]        CALL TXD
0C98: E1       [144]        POP HL              ; Basılacak asıl adresi geri al
                        
                            ; 16 byte'lık veriyi hex olarak bas
0C99: 0610     [151]        LD B, 16
0C9B:                   DRAW_EDIT_LOOP:
0C9B: 7E       [ 7]         LD A, (HL)
0C9C: CD2510   [24]         CALL HEXOUT
0C9F: 3E20     [31]         LD A, ' '
