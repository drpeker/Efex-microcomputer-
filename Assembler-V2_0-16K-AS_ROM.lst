                        ;****************************************************************
                        ;* PARSE_HEX_CHAR ALT PROGRAMI                                  *
                        ;* Açıklama: HL'nin gösterdiği adresteki karakteri okur. Eğer   *
                        ;* karakter geçerli bir hex ise, 4-bitlik değerini A'ya yazar,  *
                        ;* HL'yi bir artırır ve Carry=0 ile döner. Geçersizse,          *
                        ;* Carry=1 ile döner.                                           *
                        ;* Girdi: HL = Buffer içindeki karakterin adresi                *
                        ;* Çıktı: Başarılıysa -> Carry=0, A=Sayısal değer (0-15), HL artırılmış*
                        ;* Başarısızsa -> Carry=1, A=Karakterin ASCII kodu, HL aynı*
                        ;****************************************************************
01D3:                   PARSE_HEX_CHAR:
01D3: 7E       [ 7]         LD A, (HL)          ; Buffer'dan karakteri oku
01D4: CD7802   [24]         CALL UPPERCASE      ; Kontrol kolaylığı için büyük harfe çevir
                        
                            ; --- DOĞRULAMA KISMI ---
01D7: FE30     [31]         CP '0'
01D9: DAFA01   [41|41]      JP C, NOT_A_HEX     ; '0'dan küçükse geçersiz
01DC: FE3A     [48]         CP '9' + 1
01DE: DAEE01   [58|58]      JP C, CONVERT_DIGIT ; '9'dan büyük değilse, bu bir rakamdır
                        
01E1: FE41     [65]         CP 'A'
01E3: DAFA01   [75|75]      JP C, NOT_A_HEX     ; 'A'dan küçükse geçersiz
01E6: FE47     [82]         CP 'F' + 1
01E8: D2FA01   [92|92]      JP NC, NOT_A_HEX    ; 'F'den büyükse geçersiz
                            
                            ; Karakter 'A'-'F' aralığındadır
01EB: C3F301   [102]        JP CONVERT_LETTER
                        
01EE:                   CONVERT_DIGIT:
01EE: D630     [ 7]         SUB '0'             ; ASCII değerini sayısal değere çevir
01F0: C3F701   [17]         JP CONVERSION_OK
                        
01F3:                   CONVERT_LETTER:
01F3: D641     [ 7]         SUB 'A'             ; 'A'->0, 'B'->1, ...
01F5: C60A     [14]         ADD A, 10           ; Doğru sayısal değeri bulmak için 10 ekle
                        
01F7:                   CONVERSION_OK:
01F7: 23       [ 6]         INC HL              ; Başarılı, buffer işaretçisini bir sonraki karaktere ilerlet
01F8: B7       [10]         OR A                ; Carry bayrağını temizle (başarı sinyali)
01F9: C9       [20]         RET
                        
01FA:                   NOT_A_HEX:
01FA: 37       [ 4]         SCF                 ; Carry bayrağını set et (hata sinyali)
01FB: C9       [14]         RET    
                        ;------------hex to byte from buffer ended------------------------------------
                        ;****************************************************************
                        ;* PARSE_HEX_ADDRESS ALT PROGRAMI                               *
                        ;* Açıklama: HL'nin gösterdiği yerden başlayarak 1-4 haneli hex *
                        ;* bir adresi okur. Sonucu DE register'ına yazar.               *
                        ;* Girdi: HL = Buffer'da adresin başladığı yer                   *
                        ;* Çıktı: Başarılıysa -> Carry=0, DE=16-bit adres, HL=sonraki karakter*
                        ;* Başarısızsa -> Carry=1 (hiç hex karakter bulunamadıysa)      *
                        ;****************************************************************
                        ; ------------------------------------------------------------
                        ; PARSE_HEX_ADDRESS  (Z80 mnemonics, 8085-compatible)
                        ;  In : HL -> girdi metni (hexdigit'lerle başlıyor olabilir)
                        ; Out : CF=0 ve DE = parsed 16-bit değer, HL = ilk hexdigit olmayan
                        ;       CF=1 (hata: hiç hexdigit yok) ve HL girişteki konumda
                        ; Clobbers: A, B, C, D, E, F   (HL çağrı sözleşmesine göre güncellenir)
                        ; Notlar:
                        ; - En fazla 4 hexdigit okunur (16-bit sınırı). 5. hexdigit bırakılır.
                        ; - '0'..'9', 'A'..'F', 'a'..'f' kabul edilir (buffer değiştirilmez).
                        ; ------------------------------------------------------------
                        ;******************************************************************************
                        ;* PARSE_HEX_ADDRESS (Nihai Sürüm - Basit, Kararlı, Z80 Sözdizimli)           *
                        ;* Açıklama: HL'nin gösterdiği yerden 1-4 haneli hex adresi okur.            *
                        ;* Sonucu sağa dayalı olarak hesaplar (Örn: "F" -> 000FH, "1F4" -> 01F4H).     *
                        ;* Girdi: HL = Ana buffer'da adresin başladığı yer                            *
                        ;* Çıktı: Başarılıysa -> Carry=0, DE=16-bit adres, HL=sayıdan sonraki karakter *
                        ;* Başarısızsa -> Carry=1 (hiç hex karakter bulunamadıysa)             *
                        ;******************************************************************************
                        ;******************************************************************************
                        ;* PARSE_HEX_ADDRESS (Sıfırdan Yazılmış Nihai Versiyon)                       *
                        ;* Açıklama: HL'nin gösterdiği yerden 1-4 haneli hex adresi okur.            *
                        ;* Sonucu sağa dayalı olarak hesaplar (Örn: "F" -> 000FH, "1F4" -> 01F4H).     *
                        ;* Girdi: HL = Ana buffer'da adresin başladığı yer                            *
                        ;* Çıktı: Başarılıysa -> Carry=0, DE=16-bit adres, HL=sayıdan sonraki karakter *
                        ;* Başarısızsa -> Carry=1 (hiç hex karakter bulunamadıysa)             *
                        ;******************************************************************************
01FC:                   PARSE_HEX_ADDRESS:
01FC: 110000   [10]         LD DE, 0          ; 1. Sonuç register'ı (DE) her zaman SIFIRDAN başlar.
01FF: 0604     [17]         LD B, 4           ; 2. En fazla 4 hane okumak için sayaç.
                        
0201:                   PARSE_LOOP_FINAL:
0201: 78       [ 4]         LD A, B
0202: FE00     [11]         CP 0
0204: CA3E02   [21|21]      JP Z, PARSE_EXIT_FINAL ; Sayaç bittiyse (4 hane okunduysa) çık.
                        
0207: 7E       [28]         LD A, (HL)        ; Buffer'dan sıradaki karakteri oku.
                        
                            ; --- KARAKTERİ DOĞRUDAN İÇERİDE ÇEVİR VE KONTROL ET ---
0208: CD7802   [45]         CALL UPPERCASE      ; 'a'-'f' ise 'A'-'F' yap.
020B: D5       [56]         PUSH DE             ; Ara sonucu (DE) ve sayacı (B) koru.
020C: C5       [67]         PUSH BC
                            
                            ; Gelen karakterin (A) sayısal değerini (0-15) bulalım.
020D: D630     [74]         SUB '0'
020F: DA3C02   [84|84]      JP C, NOT_HEX_FINAL ; '0'dan küçükse hex değildir.
0212: FE0A     [91]         CP 10
0214: DA2702   [101|101]    JP C, IS_VALID_HEX  ; 0-9 arasındaysa geçerlidir.
                            
0217: 7E       [108]        LD A, (HL)          ; Karakteri tekrar yükle (çünkü SUB '0' ile bozuldu)
0218: CD7802   [125]        CALL UPPERCASE
021B: D641     [132]        SUB 'A'
021D: DA3C02   [142|142]    JP C, NOT_HEX_FINAL ; 'A'dan küçükse hex değildir.
0220: FE06     [149]        CP 6                ; 'F'-'A' = 5. 6'dan büyük veya eşitse geçersiz.
0222: D23C02   [159|159]    JP NC, NOT_HEX_FINAL
0225: C60A     [166]        ADD A, 10           ; 'A'-'F' ise 10-15 arası değere çevir.
                        
0227:                   IS_VALID_HEX:
                            ; Başarılı: A register'ı 0-15 arası doğru değeri içeriyor.
0227: C1       [10]         POP BC              ; Sayaçları geri al.
0228: D1       [20]         POP DE              ; Ara sonucu geri al.
                        
                            ; --- BASİTLEŞTİRİLMİŞ "KAYDIR VE EKLE" ---
                            ; a) Mevcut sonucu (DE) 16 ile çarp.
0229: E5       [31]         PUSH HL             ; Buffer işaretçisi HL'yi KORU!
022A: 626B     [39]         LD HL, DE
022C: 29       [50]         ADD HL, HL          ; HL = HL * 2
022D: 29       [61]         ADD HL, HL          ; HL = HL * 4
022E: 29       [72]         ADD HL, HL          ; HL = HL * 8
022F: 29       [83]         ADD HL, HL          ; HL = HL * 16
                            
                            ; b) Yeni haneyi ekle.
0230: 5F       [87]         LD E, A             ; Yeni haneyi (0-15) E'ye koy.
0231: 1600     [94]         LD D, 0             ; D'yi sıfırla.
0233: 19       [105]        ADD HL, DE          ; HL = (Eski Sonuç * 16) + Yeni Hane
0234: 545D     [113]        LD DE, HL           ; Nihai sonucu DE'ye geri al.
0236: E1       [123]        POP HL              ; Buffer işaretçisi HL'yi GERİ YÜKLE!
                            
0237: 23       [129]        INC HL              ; Ana buffer'da bir sonraki karaktere geç.
0238: 05       [133]        DEC B               ; Kalan hane hakkını azalt.
0239: C30102   [143]        JP PARSE_LOOP_FINAL ; Döngüye devam et.
                        
023C:                   NOT_HEX_FINAL:
                            ; Başarısız: Karakter hex değil, sayı bitti demektir.
023C: C1       [10]         POP BC              ; Stack'i düzeltmek için register'ları geri al.
023D: D1       [20]         POP DE
                            ; Kasıtlı olarak döngüden çıkmak için PARSE_EXIT_FINAL'a atla.
                        
023E:                   PARSE_EXIT_FINAL:
                            ; Okunan hane sayısını bul: 4 - B'de kalan sayı
023E: 3E04     [ 7]         LD A, 4
0240: 90       [11]         SUB B
0241: FE00     [18]         CP 0
0243: CA4802   [28|28]      JP Z, PARSE_ERROR_FINAL ; Hiç hane okunmadıysa hata.
                        
0246: B7       [32]         OR A                ; Başarı sinyali (Carry=0).
0247: C9       [42]         RET
                        
0248:                   PARSE_ERROR_FINAL:
0248: 37       [ 4]         SCF                 ; Hata sinyali (Carry=1).
0249: C9       [14]         RET
                        ;----------------ADRESS PARSER (FROM BUFFER) ENDED-----------------  
                        
                        ;******************************************************************************
                        ;* PARSE_HEX_BYTE ALT PROGRAMI (Yeni)                                         *
                        ;* Açıklama: HL'nin gösterdiği yerden 1 veya 2 haneli hex sayıyı okur.        *
                        ;* Sonucu 8-bit olarak A register'ına yazar.                                  *
                        ;* Girdi: HL = Ana buffer'da sayının başladığı yer                            *
                        ;* Çıktı: Başarılıysa -> Carry=0, A=8-bit değer, HL=sayıdan sonraki karakter   *
                        ;* Başarısızsa -> Carry=1 (hiç hex karakter bulunamadıysa)               *
                        ;******************************************************************************
                        ;******************************************************************************
                        ;* PARSE_HEX_BYTE (YENİ, GÜVENLİ ve BASİT Versiyon)                           *
                        ;* Açıklama: HL'nin gösterdiği yerden 1 veya 2 haneli hex sayıyı okur.        *
                        ;* Kendi içinde PUSH/POP kullanmadığı için yığını bozmaz.                     *
                        ;* Girdi: HL = Ana buffer'da sayının başladığı yer                            *
                        ;* Çıktı: Başarılıysa -> Carry=0, A=8-bit değer, HL=sayıdan sonraki karakter   *
                        ;* Başarısızsa -> Carry=1 (hiç hex karakter bulunamadıysa)               *
                        ;******************************************************************************
024A:                   PARSE_HEX_BYTE:
                            ; --- İlk haneyi okumayı dene ---
024A: CDD301   [17]         CALL PARSE_HEX_CHAR
024D: DA6402   [27|27]      JP C, PARSE_BYTE_ERROR   ; Hiç hane yoksa doğrudan hata ver.
                        
0250: 47       [31]         LD B, A                  ; İlk hanenin değerini (0-15) B'de sakla.
                                                     ; HL, PARSE_HEX_CHAR tarafından ilerletildi.
                            
                            ; --- İkinci haneyi okumayı dene ---
                            ; NOT: HL zaten bir sonraki karakteri gösteriyor.
0251: CDD301   [48]         CALL PARSE_HEX_CHAR
                            
                            ; Eğer ikinci karakter hex değilse (Carry=1 ise), sonuç tek hanelidir.
0254: DA6102   [58|58]      JP C, PARSE_BYTE_DONE_1
                        
                            ; --- İki hane de bulundu. A'da ikinci hane, B'de ilk hane var. Birleştir. ---
0257: 4F       [62]         LD C, A                  ; İkinci haneyi C'de sakla.
0258: 78       [66]         LD A, B                  ; Birinci haneyi A'ya al.
0259: 87       [70]         ADD A, A                 ; A = A * 2
025A: 87       [74]         ADD A, A                 ; A = A * 4
025B: 87       [78]         ADD A, A                 ; A = A * 8
025C: 87       [82]         ADD A, A                 ; A = A * 16
025D: 81       [86]         ADD A, C                 ; A = (Birinci hane * 16) + İkinci hane
025E: C36202   [96]         JP PARSE_BYTE_DONE_2
                        
0261:                   PARSE_BYTE_DONE_1:
                            ; Sonuç tek haneli. Değer zaten B'deydi.
0261: 78       [ 4]         LD A, B
0262:                   PARSE_BYTE_DONE_2:
0262: B7       [ 4]         OR A                     ; Başarı sinyali (Carry=0).
0263: C9       [14]         RET
                        
0264:                   PARSE_BYTE_ERROR:
0264: 37       [ 4]         SCF                      ; Hata sinyali (Carry=1).
0265: C9       [14]         RET
                        
                        
                        
                        
                        ;-----------------hex byte parsing ended here----------------------
0266:                   CRLF: 
0266: 3E0A     [ 7]         LD A,0AH
0268: CD9410   [24]         CALL TXD
026B: 3E0D     [31]         LD A,0DH
026D: CD9410   [48]         CALL TXD
0270: C9       [58]         RET
                        
                        
0271:                   PROMPT:	
                            ; Yeşil  renkli prompt basalım
                        
                            ; --- 1. Adım: Kırmızı renk kodunu gönder ---
                        ;    LD A, 1BH           ; ESC karakteri
                        ;    CALL TXD
                        ;    LD A, '['           ; CSI karakteri
                        ;    CALL TXD
                        ;    LD A, '3'           ; Parametre '3'
                        ;    CALL TXD
                        ;    LD A, '2'           ; Parametre '1'
                        ;    CALL TXD
                        ;    LD A, 'm'           ; Komut karakteri 'm'
                        ;    CALL TXD
                        
                            ; --- 2. Adım: Asıl metni gönder ---
0271: 215811   [10]         LD HL,TABLE6 
0274: CDEB03   [27]     	CALL PRINT
                        
                            ; --- 3. Adım: Rengi sıfırla (ÇOK ÖNEMLİ!) ---
                        ;    LD A, 1BH           ; ESC karakteri
                        ;    CALL TXD
                        ;    LD A, '['           ; CSI karakteri
                        ;    CALL TXD
                        ;    LD A, '0'           ; Sıfırlama parametresi '0'
                        ;    CALL TXD
                        ;    LD A, 'm'           ; Komut karakteri 'm'
                        ;    CALL TXD
                        
                        ; ... (Kırmızı renk ayarlanır ve "HATA!" yazılır) ...
                        
                        ; --- 3. Adım: Rengi NORMALE (Beyaz/Mavi) döndür ---
                        ;    LD A, 1BH           ; ESC
                        ;    CALL TXD
                        ;    LD A, '['
                        ;    CALL TXD
                        ;    LD A, '3'           ; Beyaz yazı parametresi (37)
                        ;    CALL TXD
                        ;    LD A, '7'
                        ;    CALL TXD
                        ;    LD A, ';'           ; Parametre ayırıcı
                        ;    CALL TXD
                        ;    LD A, '4'           ; Mavi zemin parametresi (44)
                        ;    CALL TXD
                        ;    LD A, '4'
                        ;    CALL TXD
                        ;    LD A, 'm'
                        ;    CALL TXD
                        
0277: C9       [37]     	RET
                        
                        ;UPPERCASE:     ;international keyboard   
                        
                        ;                CP 'a'            ; A 'a'dan küçük mü?
                        ;                JP C, DONEUP       ; Evetse, atla
                        ;                CP 'z'+1          ; A 'z'den büyük mü?
                        ;                JP NC, DONEUP       ; Hayırsa, atla
                        ;                SUB 0x20          ; Küçük harfse büyük harfe dönüştür
                        ;DONEUP:           RET               ; İşlemi bitir   
                        	
0278:                   UPPERCASE:
                            ; --- Adım 1: Türkçe 'ı' (noktasız i) için özel kontrol ---
0278: FEFD     [ 7]         CP      0FDH            ; Karakter 'ı' mı?
027A: C28202   [17|17]      JP      NZ, KONTROL_I_BUYUK ; Değilse, sonraki kontrole git
027D: 3E49     [24]         LD      A, 'I'          ; Evetse, 'I' yap
027F: C39802   [34]         JP      DONEUP          ; Ve çık
                        
0282:                   KONTROL_I_BUYUK:
                            ; --- Adım 2: Türkçe 'İ' (büyük i) için özel kontrol ---
                            ; Shift/CapsLock ile 'i'ye basıldığında bu karakter gelir
0282: FEDD     [ 7]         CP      0DDH            ; Karakter 'İ' mi?
0284: C28C02   [17|17]      JP      NZ, KONTROL_STD ; Değilse, standart kontrole git
0287: 3E49     [24]         LD      A, 'I'          ; Evetse, bunu da standart 'I' yap
0289: C39802   [34]         JP      DONEUP          ; Ve çık
                        
028C:                   KONTROL_STD:
                            ; --- Adım 3: Standart 'a'-'z' aralığını kontrol et ---
028C: FE61     [ 7]         CP      'a'
                            ; 'a'dan küçükse (A-Z, 0-9, vs) dokunma Bu, 'I' harfinin de
                            ; değişmeden kalmasını sağlar
028E: DA9802   [17|17]      JP      C, DONEUP
0291: FE7B     [24]         CP      'z' + 1
                            ; 'z'den büyükse (diğer özel karakterler) dokunma
0293: D29802   [34|34]      JP      NC, DONEUP
                            
                            ; --- Adım 4: Güvenli çevirme işlemi ---
                            ; Bu aralık küçük 'i' harfini içerir ve onu 'I' harfine dönüştürür
0296: D620     [41]         SUB     020H
                        
0298:                   DONEUP:
0298: C9       [10]         RET    
                        ;-------------uppercase ended--------------------------------
                        
                        ;******************************************************************************
                        ;* TEXT_EDITOR_CMD - Metin Düzenleyici (Tam ve Düzeltilmiş Sürüm)             *
                        ;* Açıklama: Belirtilen adresten itibaren 32 byte'lık metni interaktif olarak *
                        ;* düzenler. Backspace ve Enter tuşlarını destekler. ESC ile çıkıldığında     *
                        ;* metnin sonuna 00H ekler.                                                    *
                        ;******************************************************************************
0299:                   TEXT_EDITOR_CMD:
                            ; --- Komutun geri kalanını doğrula ("EXT") ---
0299: 23       [ 6]         INC HL
029A: 7E       [13]         LD A, (HL)
029B: FE45     [20]         CP 'E'
029D: C2CB01   [30|30]      JP NZ, ERROR_PARSER
02A0: 23       [36]         INC HL
02A1: 7E       [43]         LD A, (HL)
02A2: FE58     [50]         CP 'X'
02A4: C2CB01   [60|60]      JP NZ, ERROR_PARSER
02A7: 23       [66]         INC HL
02A8: 7E       [73]         LD A, (HL)
02A9: FE54     [80]         CP 'T'
02AB: C2CB01   [90|90]      JP NZ, ERROR_PARSER
02AE: 23       [96]         INC HL
                        
                            ; --- Adresi ayrıştır ve değişkenleri başlat ---
02AF: CD3F0E   [113]        CALL SKIP_SPACES
02B2: CDFC01   [130]        CALL PARSE_HEX_ADDRESS
02B5: DACB01   [140|140]    JP C, ERROR_PARSER      ; Adres bulunamadıysa hata ver
02B8: 626B     [148]        LD HL, DE               ; Başlangıç adresini HL'ye al
                            
02BA: 2284FF   [164]        LD (TXT_START_ADR), HL
02BD: 2286FF   [180]        LD (TXT_CURSOR_ADR), HL
02C0: 2288FF   [196]        LD (TXT_MAX_ADR), HL    ; Maksimum adres başlangıçta imleç ile aynı
                        
                        ; --- DÜZENLEME EKRANINI ÇİZME VE DÖNGÜ ---
02C3:                   TXT_EDIT_START:
02C3: CD6602   [17]         CALL CRLF
02C6: CD7303   [34]         CALL DRAW_TEXT_LINE     ; 32 karakterlik metin satırını çiz
02C9: CDA603   [51]         CALL MOVE_CURSOR_TO_START ; İmleci düzenleme alanının başına çek
                        
02CC:                   TXT_EDIT_LOOP:
02CC: CDA010   [17]         CALL RXD                ; Bir tuş oku
                        
                            ; --- Tuş kontrolleri ---
02CF: FE1B     [24]         CP 1BH                  ; ESC mi?
02D1: CA6703   [34|34]      JP Z, TXT_EDIT_EXIT     ; Evetse, çıkış yap
                        
02D4: FE0D     [41]         CP 0DH                  ; Enter mı?
02D6: CA0503   [51|51]      JP Z, TXT_EDIT_FORWARD  ; Evetse, imleci bir ileri al
                        
02D9: FE08     [58]         CP 08H                  ; Backspace mi?
02DB: CA4903   [68|68]      JP Z, TXT_EDIT_BACKWARD ; Evetse, imleci bir geri al
                        
                            ; --- Yazdırılabilir karakter mi kontrolü ---
02DE: FE20     [75]         CP 20H
02E0: DACC02   [85|85]      JP C, TXT_EDIT_LOOP     ; Kontrol karakteriyse (boşluk hariç) yoksay
02E3: FE7F     [92]         CP 7FH
02E5: D2CC02   [102|102]    JP NC, TXT_EDIT_LOOP    ; Genişletilmiş ASCII ise yoksay
                        
                            ; --- Normal karakteri yaz ve ilerle ---
02E8: 2A86FF   [118]        LD HL, (TXT_CURSOR_ADR)
02EB: 77       [125]        LD (HL), A              ; Karakteri belleğe yaz
02EC: 7E       [132]        LD A,(HL)        ;ADRESTEKİ GERÇEK VERİYİ GÖSTERİR!
                         
                          ; 3. Adım: Geri okunan karakterin yazdırılabilir olup olmadığını DENETLE
02ED: FE20     [139]        CP 20H
02EF: DAFD02   [149|149]    JP C, TXT_PRINT_DOT     ; Yazdırılamazsa, nokta basmaya git
02F2: FE7F     [156]        CP 7FH
02F4: D2FD02   [166|166]    JP NC, TXT_PRINT_DOT    ; Yazdırılamazsa, nokta basmaya git
                        
                            
                        
                        
                         
02F7: CD9410   [183]        CALL TXD                ; Karakteri ekrana bas (üzerine yaz)
02FA: C31E03   [193]        JP TXT_EDIT_FORWARD_NO_ECHO ; Bellek adresini ve imleç pozisyonunu güncelle
02FD:                   TXT_PRINT_DOT:
                            ; Karakter yazdırılamaz, onun yerine ekrana nokta bas
02FD: 3E2E     [ 7]         LD A, '.'
02FF: CD9410   [24]         CALL TXD
0302: C31E03   [34]         JP TXT_EDIT_FORWARD_NO_ECHO ; Her iki durumda da imleci ilerletmek için ortak bölüme atla
                        ;******************************************************************************
                        ;* İMLEÇ HAREKETLERİ (DÜZELTİLMİŞ)                                             *
                        ;******************************************************************************
                        
0305:                   TXT_EDIT_FORWARD:
                            ; İmleci ileri almadan önce, o pozisyondaki karakteri ekrana bozulma yapmayacak şekilde bas.
0305: 2A86FF   [16]         LD HL, (TXT_CURSOR_ADR)
0308: 7E       [23]         LD A, (HL)
0309: FE20     [30]         CP 20H                  ; Yazdırılabilir karakter mi?
030B: DA1903   [40|40]      JP C, PRINT_DOT_AND_FWD
030E: FE7F     [47]         CP 7FH
0310: D21903   [57|57]      JP NC, PRINT_DOT_AND_FWD
0313: CD9410   [74]         CALL TXD                ; Evet, kendisini basarak imleci ilerlet
0316: C31E03   [84]         JP TXT_EDIT_FORWARD_NO_ECHO
0319:                   PRINT_DOT_AND_FWD:
0319: 3E2E     [ 7]         LD A, '.'               ; Hayır, onun yerine nokta basarak imleci ilerlet
031B: CD9410   [24]         CALL TXD
                        
031E:                   TXT_EDIT_FORWARD_NO_ECHO:
                            ; Satır sonu kontrolü: İmlecin satırın dışına taşmasını engelle.
031E: 2A86FF   [16]         LD HL, (TXT_CURSOR_ADR)
0321: ED5B84FF [36]         LD DE, (TXT_START_ADR)
0325: D5       [47]         PUSH DE                 ; DE'yi (başlangıç adresi) koru
0326: B7       [51]         OR A                    ; Carry'i temizle
0327: ED52     [66]         SBC HL, DE              ; HL = (mevcut imleç - başlangıç) = ofset
0329: 7D       [70]         LD A, L                 ; Sadece L'ye bakmak yeterli (çünkü fark < 255)
032A: FE1F     [77]         CP 31                   ; Ofset 31'e ulaştı mı? (32. ve son karakter)
032C: D1       [87]         POP DE                  ; DE'yi geri al
032D: CACC02   [97|97]      JP Z, TXT_EDIT_LOOP     ; Evetse, satır sonundayız, daha fazla ilerleme
                        
                            ; İmleç adresini bir artır
0330: 2A86FF   [113]        LD HL, (TXT_CURSOR_ADR)
0333: 23       [119]        INC HL
0334: 2286FF   [135]        LD (TXT_CURSOR_ADR), HL
                            
                            ; Maksimum imleç pozisyonunu (null terminator için) doğru kaydet.
0337: ED5B88FF [155]        LD DE, (TXT_MAX_ADR)
033B: E5       [166]        PUSH HL                 ; HL'yi (yeni imleç) koru
033C: B7       [170]        OR A                    ; Carry'i temizle
033D: ED52     [185]        SBC HL, DE              ; HL = yeni_imleç - eski_maks
033F: E1       [195]        POP HL                  ; HL'yi geri al
0340: FACC02   [205|205]    JP M, TXT_EDIT_LOOP     ; Eğer sonuç negatifse (HL < DE), güncelleme yapma, döngüye dön
                                                    ; JP C de kullanılabilir, SBC sonrası C=1 ise borç alındı demektir.
                            
                            ; Eğer sonuç pozitif veya sıfırsa (HL >= DE), yeni maksimum pozisyonu kaydet
0343: 2288FF   [221]        LD (TXT_MAX_ADR), HL
0346: C3CC02   [231]        JP TXT_EDIT_LOOP
                        
0349:                   TXT_EDIT_BACKWARD:
                            ; Satır başı kontrolü
0349: 2A86FF   [16]         LD HL, (TXT_CURSOR_ADR)
034C: ED5B84FF [36]         LD DE, (TXT_START_ADR)
0350: B7       [40]         OR A                    ; Carry'i temizle
0351: ED52     [55]         SBC HL, DE
0353: 7C       [59]         LD A, H                 ; Sonuç 0 ise (HL == DE) satır başındayız
0354: B5       [63]         OR L
0355: CACC02   [73|73]      JP Z, TXT_EDIT_LOOP     ; Satır başındaysan daha fazla geri gitme
                        
                            ; İmleç adresini bir azalt ve ekranda geri git
0358: 2A86FF   [89]         LD HL, (TXT_CURSOR_ADR)
035B: 2B       [95]         DEC HL
035C: 2286FF   [111]        LD (TXT_CURSOR_ADR), HL
035F: 3E08     [118]        LD A, 08H               ; Ekranda imleci bir geri çek
0361: CD9410   [135]        CALL TXD
0364: C3CC02   [145]        JP TXT_EDIT_LOOP
                        
                        ;******************************************************************************
                        ;* ÇIKIŞ VE YARDIMCI RUTİNLER                                                 *
                        ;******************************************************************************
                        
0367:                   TXT_EDIT_EXIT:
0367: 2A88FF   [16]         LD HL, (TXT_MAX_ADR)    ; İmlecin ulaştığı en son adresi al
036A: 3E00     [23]         LD A, 0                 ; Null karakteri
036C: 77       [30]         LD (HL), A              ; Metnin sonuna ekle
036D: CD6602   [47]         CALL CRLF
0370: C31B01   [57]         JP INPUT                ; Ana menüye dön
                        
0373:                   DRAW_TEXT_LINE:
0373: 2A84FF   [16]         LD HL, (TXT_START_ADR)
0376: 7C       [20]         LD A, H
0377: CD5110   [37]         CALL HEXOUT
037A: 7D       [41]         LD A, L
037B: CD5110   [58]         CALL HEXOUT
037E: 3E3A     [65]         LD A, ':'
0380: CD9410   [82]         CALL TXD
0383: 3E20     [89]         LD A, ' '
0385: CD9410   [106]        CALL TXD
0388: 0620     [113]        LD B, 32                ; 32 karakter bas
038A:                   DRAW_TEXT_LOOP:
038A: 7E       [ 7]         LD A, (HL)
038B: FE20     [14]         CP 20H                  ; Yazdırılabilir karakter mi?
038D: DA9B03   [24|24]      JP C, DRAW_DOT_CHAR
0390: FE7F     [31]         CP 7FH
0392: D29B03   [41|41]      JP NC, DRAW_DOT_CHAR
0395: CD9410   [58]         CALL TXD                ; Evet, kendisini bas
0398: C3A003   [68]         JP DRAW_CHAR_DONE
039B:                   DRAW_DOT_CHAR:
039B: 3E2E     [ 7]         LD A, '.'               ; Hayır, nokta bas
039D: CD9410   [24]         CALL TXD
03A0:                   DRAW_CHAR_DONE:
03A0: 23       [ 6]         INC HL
03A1: 05       [10]         DEC B
03A2: C28A03   [20|20]      JP NZ, DRAW_TEXT_LOOP
03A5: C9       [30]         RET
                        
03A6:                   MOVE_CURSOR_TO_START:
03A6: 0620     [ 7]         LD B, 32                ; DÜZELTME: İmleci 32 karakter geri çek (sadece metin alanı kadar)
03A8:                   MOVE_CURSOR_LOOP:
03A8: 3E08     [ 7]         LD A, 08H
03AA: CD9410   [24]         CALL TXD
03AD: 05       [28]         DEC B
03AE: C2A803   [38|38]      JP NZ, MOVE_CURSOR_LOOP
03B1: C9       [48]         RET
                        
                        
                        
                        
                        ;----------------HELP-------------------------
03B2:                   HELP:
03B2: 23       [ 6]         INC HL
03B3: 05       [10]         DEC B ; H RECEIVED, SO DECREASE POINTER AND COUNTER
03B4: 7E       [17]         LD A,(HL)
03B5: FE45     [24]         CP 'E'
03B7: C2CB01   [34|34]      JP NZ, ERROR_PARSER
03BA: 23       [40]         INC HL
03BB: 05       [44]         DEC B ; E RECEIVED, SO DECREASE POINTER AND COUNTER
03BC: 7E       [51]         LD A,(HL)
03BD: FE4C     [58]         CP 'L'
03BF: C2CB01   [68|68]      JP NZ, ERROR_PARSER
03C2: 23       [74]         INC HL
03C3: 05       [78]         DEC B ; L RECEIVED, SO DECREASE POINTER AND COUNTER
03C4: 7E       [85]         LD A,(HL)
03C5: FE50     [92]         CP 'P'
03C7: C2CB01   [102|102]    JP NZ, ERROR_PARSER
03CA: C3CD03   [112]        JP HELPEXEC
                        
03CD:                   HELPEXEC:	             ;HELP MSG
03CD: 215F11   [10]     	LD HL,TABLE21
03D0: CDEB03   [27]     	CALL PRINT
                        	
                        	
03D3: C31B01   [37]     	JP INPUT
                            ;JP MA_IN
                        	
                        
                        	
                        
                        	
                        ;--------------DELAY 500MS---------------	
03D6:                   DE_LAY:
                        	
03D6: D5       [11]     	PUSH DE
03D7: F5       [22]     	PUSH AF
03D8: 1100FF   [32]     	LD DE,0FF00H
03DB:                   DISDELAY:
03DB: 1B       [ 6]     	DEC DE
03DC: 7A       [10]     	LD A,D
03DD: B3       [14]     	OR E
03DE: C2DB03   [24|24]  	JP NZ,DISDELAY
03E1: D1       [34]     	POP DE
03E2: F1       [44]     	POP AF
03E3: C9       [54]     	RET
                        ;--------------------------------------	
                        ;--------------DELAY 1S----------------
03E4:                   DELAY_1S:
03E4: CDD603   [17]     	CALL DE_LAY
03E7: CDD603   [34]     	CALL DE_LAY
03EA: C9       [44]     	RET
                        ;--------------------------------------
                        
                        ;---------PRINT SUBROUTINE-------------
                        
                        	
03EB: 7E       [ 7]     PRINT:	LD A,(HL)
03EC: FE00     [14]     		CP 0
03EE: CAF803   [24|24]  		JP Z,PRINTDONE
03F1: CD9410   [41]     		CALL TXD
03F4: 23       [47]     		INC HL
03F5: C2EB03   [57|57]  		JP NZ,PRINT
03F8:                   PRINTDONE:		
03F8: C9       [10]     		RET
                        ;--------------------------------------	
                        
                        ;----------------INIT-8255----------------------------------
                        
03F9:                   	INIT8255:	;8255 @PORT 018H-01BH  ; 8255 BASE ADRESS: 08H
                        
03F9: CDD603   [17]         CALL DE_LAY ;WAIT 500MS FOR 8255 TO RESET
03FC: 3E92     [24]     	LD A,092H
03FE: D30B     [35]     	OUT (0BH),A 	;A(08H) AND B(09H)  C(0AH)  CONTROL: OBH
                        	
                        	;9B: A,B,C ALL INPUT
                        	;90: A INPUT, B AND C OUTPUT
                        	;80: A,B,C ALL OUTPUT
                        	;92: A AND B INPUT, C OUTPUT
                        	;82: A OUTPUT, B INPUT, C OUTPUT
0400: C9       [45]         RET
                        
                            
                        ;----------------INIT-8251----------------------------------
                        
                        
                        
                        
                        
                        
                        
                        ;****************************************************************
                        ;* INIT8251 - 8251A UART Başlatma Rutini                        *
                        ;* Açıklama: Bu rutin, 8251A'yı güvenilir bir şekilde başlatır,  *
                        ;* senkronize eder ve standart 8-N-1 modunda çalışmaya hazırlar.*
                        ;****************************************************************
0401:                   INIT8251:
                            ;; Adım 1: Senkronizasyon (Sync)
                            ;; 8251'in hangi modda olduğundan emin olmak için, önce üç kez
                            ;; 00h göndererek komut moduna girmeye zorlanır. Bu, tekrarlanan
                            ;; 40h göndermekten daha güvenilir bir yöntemdir.
0401: 3E00     [ 7]         LD A, 00H
0403: D301     [18]         OUT (UART_CTRL), A ;FORCED COMMAND MODE
0405: 00       [22]         NOP
0406: D301     [33]         OUT (UART_CTRL), A
0408: 00       [37]         NOP
0409: D301     [48]         OUT (UART_CTRL), A
040B: 00       [52]         NOP
                        
                            ;; Adım 2: Dahili Reset (Internal Reset)
                            ;; Senkronizasyon sonrası, 40h komutu ile entegrenin iç durumu
                            ;; temizlenir ve Mod kelimesini almaya hazırlanır.
040C: 3E40     [59]         LD A, UART_CMD_RESET ;40H
040E: D301     [70]         OUT (UART_CTRL), A
0410: 00       [74]         NOP
0411: 00       [78]         NOP
                        
                            ;; Adım 3: Mod Kelimesinin Yazılması (Mode Word)
                            ;; UART'ın temel çalışma parametreleri ayarlanır.
0412: 3E4E     [85]         LD A, UART_MODE_WORD ;04EH
0414: D301     [96]         OUT (UART_CTRL), A
0416: 00       [100]        NOP
0417: 00       [104]        NOP
                        
                            ;; Adım 4: Komut Kelimesinin Yazılması (Command Word)
                            ;; Alıcı (Rx) ve verici (Tx) aktif edilir, hata bayrakları sıfırlanır.
0418: 3E37     [111]        LD A, UART_CMD_WORD  ;037H
041A: D301     [122]        OUT (UART_CTRL), A
                        
041C: C9       [132]        RET
                          
                        	
                              
                        
                        	
                        
                        ;-------------HEXDUMP--------------------------
                        ;HEXDUMP OF INPUTTED MEMORY- +FFH
                        
                        	
041D:                   HEXDUMP:
                            ;----------------------------------------------------
                            ; 1. "DUMP <adres>" komutunu ve adresi ayrıştıran bölüm
                            ;----------------------------------------------------
041D: 23       [ 6]         INC HL
041E: 05       [10]         DEC B       ; 'D' karakterini atla
041F: 7E       [17]         LD A, (HL)
0420: FE55     [24]         CP 'U'
0422: C26507   [34|34]      JP NZ ,FROM_HEXDUMP
0425: 23       [40]         INC HL
0426: 05       [44]         DEC B       ; 'U' karakterini atla
0427: 7E       [51]         LD A, (HL)
0428: FE4D     [58]         CP 'M'
042A: C2CB01   [68|68]      JP NZ, ERROR_PARSER
042D: 23       [74]         INC HL
042E: 05       [78]         DEC B       ; 'M' karakterini atla
042F: 7E       [85]         LD A, (HL)
0430: FE50     [92]         CP 'P'
0432: C2CB01   [102|102]    JP NZ, ERROR_PARSER
0435: 23       [108]        INC HL
0436: 05       [112]        DEC B       ; 'P' karakterini atla
                        
0437: CD3F0E   [129]        CALL SKIP_SPACES
043A: CDFC01   [146]        CALL PARSE_HEX_ADDRESS
043D: DACB01   [156|156]    JP C, ERROR_PARSER
0440: 626B     [164]        LD HL, DE   ; Başarılı! Dump başlangıç adresi HL'ye alındı.
                        
                            ;-----------------------------------------------------------------
                            ; 2. YENİ ve BASİT GÖRÜNTÜLEME DÖNGÜSÜ (Eskisiyle değiştirildi)
                            ;-----------------------------------------------------------------
0442:                   DUMP_PAGE_LOOP:
0442: 111000   [10]         LD DE, 16           ; Ekrana 16 satır bas
0445:                   DUMP_LINE_LOOP:
0445: CD6304   [17]         CALL DRAW_DUMP_LINE ; Bir satırı çizmesi için alt programı çağır
0448: 1B       [23]         DEC DE
0449: 7A       [27]         LD A, D
044A: B3       [31]         OR E
044B: C24504   [41|41]      JP NZ, DUMP_LINE_LOOP
                        
                            ;------------------------------------------------------------------
                            ; 3. TUŞ BEKLEME BÖLÜMÜ (Bu blok zaten vardı ve korundu)
                            ;------------------------------------------------------------------   
                        	
044E:                   CIKIS:	
044E: CDA010   [17]         CALL RXD
0451: FE1B     [24]     	CP 01BH
0453: CA1B01   [34|34]  	JP Z,INPUT		;ESC : EXIT TO MAIN MENU
0456: FE0D     [41]     	CP 0DH
0458: CA4204   [51|51]  	JP Z, DUMP_PAGE_LOOP		;ENTER OR SPACE CONT. TO LISTING
045B: FE20     [58]     	CP 020H
045D: CA4204   [68|68]  	JP Z, DUMP_PAGE_LOOP
0460: C34E04   [78]     	JP CIKIS
                        ;******************************************************************************
                        ;* DRAW_DUMP_LINE ALT PROGRAMI                                                *
                        ;* Açıklama: HL'nin gösterdiği adresten başlayarak tam bir hexdump satırı çizer.*
                        ;* Girdi: HL = Basılacak satırın başlangıç adresi                             *
                        ;* Çıktı: HL = Bir sonraki satırın adresi (HL + 16)                           *
                        ;* Korur: AF, BC, DE                                                          *
                        ;******************************************************************************
0463:                   DRAW_DUMP_LINE:
0463: F5       [11]         PUSH AF             ; Kullanılacak register'ları korumaya al
0464: C5       [22]         PUSH BC
0465: D5       [33]         PUSH DE
                        
                            ; --- Satır başı ve Adres basımı ---
0466: 3E0D     [40]         LD A, 0DH           ; Enter
0468: CD9410   [57]         CALL TXD
046B: 3E0A     [64]         LD A, 0AH
046D: CD9410   [81]         CALL TXD
0470: 7C       [85]         LD A, H             ; Adresin yüksek byte'ını bas
0471: CD5110   [102]        CALL HEXOUT
0474: 7D       [106]        LD A, L             ; Adresin düşük byte'ını bas
0475: CD5110   [123]        CALL HEXOUT
0478: 3E3A     [130]        LD A, ':'
047A: CD9410   [147]        CALL TXD
047D: 3E20     [154]        LD A, ' '
047F: CD9410   [171]        CALL TXD
                        
                            ; --- Hex dökümünü bas (16 byte) ---
0482: 0608     [178]        LD B, 8             ; İlk 8 byte
0484:                   DRAW_HEX1:
0484: 7E       [ 7]         LD A, (HL)
0485: CD5110   [24]         CALL HEXOUT
0488: 3E20     [31]         LD A, ' '
048A: CD9410   [48]         CALL TXD
048D: 23       [54]         INC HL
048E: 05       [58]         DEC B
048F: C28404   [68|68]      JP NZ, DRAW_HEX1
                            
0492: 3E20     [75]         LD A, ' '           ; Ara boşluk
0494: CD9410   [92]         CALL TXD
0497: 3E20     [99]         LD A, ' '
0499: CD9410   [116]        CALL TXD
                            
049C: 0608     [123]        LD B, 8             ; Sonraki 8 byte
049E:                   DRAW_HEX2:
049E: 7E       [ 7]         LD A, (HL)
049F: CD5110   [24]         CALL HEXOUT
04A2: 3E20     [31]         LD A, ' '
04A4: CD9410   [48]         CALL TXD
04A7: 23       [54]         INC HL
04A8: 05       [58]         DEC B
04A9: C29E04   [68|68]      JP NZ, DRAW_HEX2
                            
                            ; Bu noktada HL, satırın sonunu (başlangıç + 16) gösteriyor.
                        
                            ; --- ASCII dökümünü bas ---
04AC: 3E20     [75]         LD A, ' '           ; Ayraç bas
04AE: CD9410   [92]         CALL TXD
                            ;LD A, '|'
                            ;CALL TXD
04B1: 3E20     [99]         LD A, ' '
04B3: CD9410   [116]        CALL TXD
                        
                            ; ASCII basımı için HL'yi 16 byte geri sar
04B6: F5       [127]        PUSH AF             ; Geri sarma işlemi için AF'yi koru
04B7: 7D       [131]        LD A, L
04B8: D610     [138]        SUB 10H
04BA: 6F       [142]        LD L, A
04BB: D2BF04   [152|152]    JP NC, NO_CARRY_SUB_DRAW
04BE: 25       [156]        DEC H
04BF:                   NO_CARRY_SUB_DRAW:
04BF: F1       [10]         POP AF
                        
                            ; 16 byte'ı karakter olarak bas
04C0: 0610     [17]         LD B, 16
04C2:                   DRAW_ASCII_LOOP:
04C2: 7E       [ 7]         LD A, (HL)
04C3: FE20     [14]         CP 20H              ; Basılabilir karakter mi?
04C5: DAD304   [24|24]      JP C, DRAW_DOT
04C8: FE7F     [31]         CP 7FH
04CA: D2D304   [41|41]      JP NC, DRAW_DOT
04CD: CD9410   [58]         CALL TXD            ; Evet, kendisini bas
04D0: C3D804   [68]         JP CHAR_DRAWN
04D3:                   DRAW_DOT:
04D3: 3E2E     [ 7]         LD A, '.'           ; Hayır, nokta bas
04D5: CD9410   [24]         CALL TXD
04D8:                   CHAR_DRAWN:
04D8: 23       [ 6]         INC HL
04D9: 05       [10]         DEC B
04DA: C2C204   [20|20]      JP NZ, DRAW_ASCII_LOOP
                            
                            ; Bu noktada HL, tekrar satırın sonunu (başlangıç + 16) gösteriyor.
                            
04DD: D1       [30]         POP DE              ; Korunan register'ları geri yükle
04DE: C1       [40]         POP BC
04DF: F1       [50]         POP AF
04E0: C9       [60]         RET	
                        
                        	
                        ;-----DUMP COMMAND ENDED HERE---------------------------------------------
                        
                        ;---------------efex-ASSEMBLER---v0.87beta-STARTS HERE---------------
                        ;                                                                    |
                        ;                      A  S  S  E  M  B  L  E  R                     |
                        ;                                                                    |
                        ;                       BACKSPACE WORKS IN TEXT                      |
                        ;                     NO BACKSPACE AFTER # OR $                      |
                        ;                         SYNTAX CHECK ADDED                         |
                        ;                                                                    |
                        ;--------------------------------------------------------------------
                        ;INPUT ASSEMBLER ADRESS-------
                        
04E1:                   ASSEMBLE:
04E1: 23       [ 6]         INC HL
04E2: 05       [10]         DEC B       ; 'A' karakterini atla
                        
04E3: 7E       [17]         LD A, (HL)
04E4: FE53     [24]         CP 'S'
04E6: C2CB01   [34|34]      JP NZ, ERROR_PARSER
04E9: 23       [40]         INC HL
04EA: 05       [44]         DEC B       ; 'S' karakterini atla
                        
04EB: 7E       [51]         LD A, (HL)
04EC: FE4D     [58]         CP 'M'
04EE: C2CB01   [68|68]      JP NZ, ERROR_PARSER
04F1: 23       [74]         INC HL
04F2: 05       [78]         DEC B       ; 'M' karakterini atla
                        
                            ; Boşluk ve $ işaretlerini atlayan yardımcı rutini çağır
04F3: CD3F0E   [95]         CALL SKIP_SPACES
                        
                            ; 1-4 haneli hex adresi okuyup 16-bit'e çeviren ana rutini çağır
04F6: CDFC01   [112]        CALL PARSE_HEX_ADDRESS
04F9: DACB01   [122|122]    JP C, ERROR_PARSER    ; Hata varsa (hiç hex karakter bulunamadıysa) çık
                        
                            ; Başarılı! 16-bitlik adres DE register'ında hazır.
04FC: 626B     [130]        LD HL, DE             ; Çalıştırılacak adresi HL'ye al
                            ;JP (HL)               ; Adrese zıpla!
04FE: 2244FF   [146]        LD (ADRSINP),HL       ; SAVE DISASSEMBLER ADRESS TO 
                        	
                        	
                        
                        
0501: 210F14   [156]    	LD HL,TABLE_ASS ;ASSEMBLER MESSAGE
0504: CDEB03   [173]    	CALL PRINT
                        	
                        	
0507: 2A44FF   [189]    	LD HL, (ADRSINP)
050A: 224EFF   [205]    	LD (ASADR),HL       ;ASSEMBLY TARGET ADRESS
                        	
                        	
050D: 3E0D     [212]    	LD A, 0DH
050F: CD9410   [229]    	CALL TXD
0512: 3E0A     [236]    	LD A, 0AH
0514: CD9410   [253]    	CALL TXD
                        	
                        	
                        ;---------------main assembler loop start here------------	
                        	
0517:                   AS_DON:	
                        
                        
                        ;===========================================================
                        ; AS_PARSER — AS_DON ile INTERPRET arasına eklenecek
                        ; 1) COMINBUF'u 0x1F temizler, DATAINP/ADRSINP/DIYEZDOLAR'ı sıfırlar
                        ; 2) 0x1F'e kadar satır okur (CR=0Dh ile biter), BACKSPACE=08h destekli
                        ; 3) Taramada:
                        ;    - '#' görülürse parse_hex_byte çağrılır; başarılı ise 2 haneyi SİLER,
                        ;      A'yı DATAINP'e yazar, DIYEZDOLAR='#' yapar.
                        ;    - '$' görülürse parse_hex_adress çağrılır; başarılı ise 4 haneyi SİLER,
                        ;      adresi ADRSINP (low,high) yazar, DIYEZDOLAR='$' yapar.
                        ;    - IM1 gibi komutlardaki rakamlar KORUNUR (sadece #/$ sonrası haneyi siler).
                        ; 4) LINELENGHT'i (DE-COMINBUF) yazar ve INTERPRET'e geçer.
                        ; Not: parse_hex_byte ve parse_hex_adress mevcut kodundaki imzalarıyla kullanılmaktadır.
                        ;===========================================================
                        
                        ;---------------main assembler loop start here------------	
                        	
0517:                   AS_DON:	
                        ;---------------main assembler loop start here------------	
                        	
                        ;---------------main assembler loop start here------------	
                        	
0517:                   AS_DON:	
                        ;******************************************************************************
                        ;* NİHAİ DÜZELTME v4.0 - (HL OKUMA İŞARETÇİSİ KORUMA HATASI GİDERİLDİ)         *
                        ;* Açıklama: Bu versiyon, $ operandı işlenirken hem yazma işaretçisi DE'nin,  *
                        ;* hem de okuma işaretçisi HL'nin stack kullanılarak doğru şekilde korunmasını *
                        ;* ve geri yüklenmesini sağlayarak önceki hatayı düzeltir.                    *
                        ;******************************************************************************
                        
                            ; --- Adım 1: Buffer ve değişkenleri temizle ---
0517: AF       [ 4]         XOR A
0518: 3254FF   [17]         LD (DIYEZDOLAR), A      
051B: 3242FF   [30]         LD (DATAINP), A         
051E: 210000   [40]         LD HL, 0
0521: 2244FF   [56]         LD (ADRSINP), HL        
                            
0524: 2100FF   [66]         LD HL, COMINBUF
0527: 0620     [73]         LD B, 32                
0529:                   AS_CLEAR_LOOP:
0529: 3600     [10]         LD (HL), 0
052B: 23       [16]         INC HL
052C: 05       [20]         DEC B
052D: C22905   [30|30]      JP NZ, AS_CLEAR_LOOP
                        
                            ; --- Adım 2: Komut satırını buffer'a al ---
0530: CD6602   [47]         CALL CRLF
0533: 2A4EFF   [63]         LD HL, (ASADR)
0536: 7C       [67]         LD A, H
0537: CD5110   [84]         CALL HEXOUT
053A: 7D       [88]         LD A, L
053B: CD5110   [105]        CALL HEXOUT
053E: 3E3E     [112]        LD A, '>'
0540: CD9410   [129]        CALL TXD
0543: 3E20     [136]        LD A, ' '
0545: CD9410   [153]        CALL TXD
                        
0548: 2100FF   [163]        LD HL, COMINBUF
054B: 061F     [170]        LD B, 31                
054D:                   AS_INPUT_LOOP:
054D: CDA010   [17]         CALL RXD
0550: CD7802   [34]         CALL UPPERCASE
0553: FE1B     [41]         CP 1BH
0555: CA1B01   [51|51]      JP Z, INPUT             
0558: FE0D     [58]         CP 0DH                  
055A: CA8A05   [68|68]      JP Z, AS_PARSE_START
055D: FE08     [75]         CP 08H                  
055F: CA6E05   [85|85]      JP Z, AS_BCKSPC
                        
0562: CD9410   [102]        CALL TXD                
0565: 77       [109]        LD (HL), A
0566: 23       [115]        INC HL
0567: 05       [119]        DEC B
0568: C24D05   [129|129]    JP NZ, AS_INPUT_LOOP
056B: C38A05   [139]        JP AS_PARSE_START       
                        
056E:                   AS_BCKSPC:
056E: 78       [ 4]         LD A, B
056F: FE1F     [11]         CP 31
0571: CA4D05   [21|21]      JP Z, AS_INPUT_LOOP     
                            
0574: 3E08     [28]         LD A, 08H
0576: CD9410   [45]         CALL TXD
0579: 3E20     [52]         LD A, ' '
057B: CD9410   [69]         CALL TXD
057E: 3E08     [76]         LD A, 08H
0580: CD9410   [93]         CALL TXD
                            
0583: 2B       [99]         DEC HL
0584: 3600     [109]        LD (HL), 0              
0586: 04       [113]        INC B
0587: C34D05   [123]        JP AS_INPUT_LOOP
                        
058A:                   AS_PARSE_START:
058A: 3600     [10]         LD (HL), 0
                        
                            ; --- Adım 3: Buffer'ı işle, sayıları ayır, rakamları sil ---
058C: 2100FF   [20]         LD HL, COMINBUF         
058F: 1100FF   [30]         LD DE, COMINBUF         
                        
0592:                   SCAN_AND_COPY_LOOP:
0592: 7E       [ 7]         LD A, (HL)
0593: FE00     [14]         CP 0                    
0595: CADF05   [24|24]      JP Z, SCAN_FINISHED
                        
0598: FE23     [31]         CP '#'
059A: CAA805   [41|41]      JP Z, HANDLE_SYMBOL
                            
059D: FE24     [48]         CP '$'
059F: CAA805   [58|58]      JP Z, HANDLE_SYMBOL
                        
05A2: 12       [65]         LD (DE), A
05A3: 23       [71]         INC HL
05A4: 13       [77]         INC DE
05A5: C39205   [87]         JP SCAN_AND_COPY_LOOP
                        
05A8:                   HANDLE_SYMBOL:
05A8: 12       [ 7]         LD (DE), A
