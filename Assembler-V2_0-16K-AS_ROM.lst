                        ; -------- RX kuyruğunu boşalt --------
                        ;****************************************************************
                        ;* GETGARBAGE - Düzeltilmiş ve Zaman Aşımlı Sürüm               *
                        ;* Açıklama: Seri porttan gelen veri akışı kesilene kadar       *
                        ;* bekleyerek tüm "çöp" veriyi temizler.                        *
                        ;****************************************************************
0ED0:                   GETGARBAGE:
0ED0: D5       [11]         PUSH DE                 ; DE register'ını koru
0ED1: 11FFFF   [21]         LD DE, 0FFFFH           ; Zaman aşımı sayacını başlat (bu değer ayarlanabilir)
                        
0ED4:                   GARBAGE_WAIT_LOOP:
0ED4: CDAE10   [17]         CALL RXNP               ; Karakter var mı diye beklemeden kontrol et (Sonuç Carry'de)
0ED7: D2E30E   [27|27]      JP NC, GARBAGE_CHAR_FOUND ; Carry=0 ise karakter bulundu, timeout'u sıfırla
                        
                            ; --- Karakter bulunamadı, zaman aşımını azalt ---
0EDA: 1B       [33]         DEC DE
0EDB: 7A       [37]         LD A, D
0EDC: B3       [41]         OR E
0EDD: C2D40E   [51|51]      JP NZ, GARBAGE_WAIT_LOOP ; Sayaç sıfır değilse beklemeye devam et
                            
                            ; --- Zaman aşımına ulaşıldı, veri akışı bitti demektir ---
0EE0: C3E90E   [61]         JP GARBAGE_EXIT
                        
0EE3:                   GARBAGE_CHAR_FOUND:
                            ; Karakter bulundu (ve RXNP tarafından A'ya okundu).
                            ; Sadece zaman aşımı sayacını sıfırla ve daha fazla karakter var mı diye bekle.
0EE3: 11FFFF   [10]         LD DE, 0FFFFH           ; Sayacı yeniden doldur
0EE6: C3D40E   [20]         JP GARBAGE_WAIT_LOOP
                        
0EE9:                   GARBAGE_EXIT:
0EE9: D1       [10]         POP DE                  ; DE register'ını geri yükle
0EEA: C9       [20]         RET
                        
                         
                        	
                        	
                        		
                        ;	*********************************
                        ;	*				*
                        ;	*     Get Intel hex record	*
                        ;	*				*
                        ;	*********************************
                        
                        ;Short version - no checksum calculation.
                        
                        ;------------------- LOAD HEX (Checksum'lu) -------------------
                        
0EEB:                   INTLIN1:
0EEB: 3E00     [ 7]             LD      A,00H
0EED: 3268FF   [20]             LD      (HEXLDREG),A
0EF0:                   INTLIN:
                                ; ':' gelene kadar bekle
0EF0:                   WAIT_COLON:
0EF0: CDA010   [17]             CALL    RXD
0EF3: FE1B     [24]             CP      1BH
0EF5: C8       [29|35]          RET     Z
0EF6: FE3A     [36]             CP      ':'
0EF8: C2F00E   [46|46]          JP      NZ, WAIT_COLON
                        
                                ; ----- Yeni kayıt: checksum akümülatörü sıfırla -----
0EFB: AF       [50]             XOR     A
0EFC: 5F       [54]             LD      E,A
                        
                                ; LENGTH
0EFD: CD8D0F   [71]             CALL    BYTERD
0F00: 47       [75]             LD      B,A
0F01: 83       [79]             ADD     A,E
0F02: 5F       [83]             LD      E,A
                        
                                ; ADDRESS HI
0F03: CD8D0F   [100]            CALL    BYTERD
0F06: 67       [104]            LD      H,A
0F07: 83       [108]            ADD     A,E
0F08: 5F       [112]            LD      E,A
                        
                                ; ADDRESS LO
0F09: CD8D0F   [129]            CALL    BYTERD
0F0C: 6F       [133]            LD      L,A
0F0D: 83       [137]            ADD     A,E
0F0E: 5F       [141]            LD      E,A
                        
                                ; Başlangıç adresini bir kez kaydet
0F0F: 3A68FF   [154]            LD      A,(HEXLDREG)
0F12: FE01     [161]            CP      01H
0F14: CA1F0F   [171|171]        JP      Z, GOT_RECT
0F17: 3E01     [178]            LD      A,01H
0F19: 3268FF   [191]            LD      (HEXLDREG),A
0F1C: 226AFF   [207]            LD      (LOADSTADR),HL
                        
0F1F:                   GOT_RECT:
                                ; RECORD TYPE
0F1F: CD8D0F   [17]             CALL    BYTERD
0F22: 57       [21]             LD      D,A                  ; D = rectype
0F23: 83       [25]             ADD     A,E
0F24: 5F       [29]             LD      E,A
                        
0F25: 7A       [33]             LD      A,D
0F26: FE01     [40]             CP      01H
0F28: CA5B0F   [50|50]          JP      Z, CHK_EOF           ; EOF → veri yok, checksum oku/doğrula
0F2B: FE00     [57]             CP      00H
0F2D: C2430F   [67|67]          JP      NZ, SKIP_DATA        ; 00 dışı tip → yazma, sadece toplamla atla
                        
                        ; ---- DATA (type 00): B bayt yaz + toplam ----
0F30:                   DATAIN:
0F30: 78       [ 4]             LD      A,B
0F31: B7       [ 8]             OR      A
0F32: CA510F   [18|18]          JP      Z, READ_CHK
